{
  "name": "sverlin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/run-with-env.sh sh -c 'pnpm run db:migrate && pnpm run dev:web'",
    "dev:web": "bash scripts/run-with-env.sh node node_modules/vite/bin/vite.js dev --configLoader native",
    "build": "pnpm exec svelte-kit sync && pnpm exec vite build",
    "build:data": "esbuild src/project-data-export.ts --bundle --platform=node --format=esm --packages=external --loader:.md=text --outfile=build-data/index.js",
    "preview": "bash scripts/run-with-env.sh node node_modules/vite/bin/vite.js preview",
    "start": "bash scripts/run-with-env.sh node build",
    "prepare": "svelte-kit sync || echo ''",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "export:data": "pnpm run build:data && node build-data/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest run --configLoader native",
    "test:postgres": "SVERLIN_RUN_POSTGRES_TESTS=1 node scripts/run-with-test-database.mjs pnpm exec vitest run --no-file-parallelism src/lib/server/*.postgres.integration.test.ts src/lib/server/projects/*.postgres.integration.test.ts",
    "test": "pnpm run test:unit && pnpm run test:postgres",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.21.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24",
    "@types/sanitize-html": "^2.16.1",
    "bits-ui": "^2.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.3.5",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "acorn": "^8.18.0",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "marked": "^18.0.11",
    "openai": "^7.5.0",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.7",
    "svelte": "^5.48.2",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2",
    "webcola": "3.4.0"
  }
}
