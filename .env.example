# Copy this file to .env if it does not exist. Shells and server launches load it.
# Use shell-compatible assignments; quote values containing spaces or shell syntax.
# Direnv reloads after changes; restart the web process to apply new server values.
# Each launch reads this file again, even if the process manager has stale values.

# Optional AI-assisted editing. Ordinary compilation works without a key.
OPENAI_API_KEY=
# Each provider call may use at most three minutes. Repair attempts only begin
# when this complete allowance remains in a timed study phase.
CHATBOT_REQUEST_TIMEOUT_MS=180000
# A summary of the model's reasoning, recorded with each response for audit: detailed (the
# default), concise, or auto; off asks for none. The reasoning itself is billed either way.
CHATBOT_REASONING_SUMMARIES=detailed

# Optional overrides. devenv supplies container defaults for empty values.
BETTER_AUTH_SECRET=
# Leave empty to use PostgreSQL inside the Dev Container.
DATABASE_URL=
