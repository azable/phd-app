{
  "$text": "#000000",
  "$font": "serif",
  "$surface": "#FFFFFF",
  "$accent": "#000000",
  "$highlight": "#E6E6E6",
  "$spacing": 0.25,
  "$radius": 0,
  "$lineWidth": 1,
  "scale": {
    "spacing": "0 0.125 0.25 0.5 1",
    "radius": "0 999",
    "type": "12 15 18 22",
    "line": "0.5 1 2",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#000000",
    "line": "#000000",
    "first": "#E6E6E6"
  },
  "<Container>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 15,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "gap": 0.5,
    "align": "center",
    "justify": "start",
    "spacing": "slots"
  },
  "<Value>": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 18,
    "weight": "normal",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Text>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 15,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Code>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "mono",
    "textSize": 15,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Icon>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 18,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "icon": "circle-dot"
  },
  "<Link>": {
    "stroke": "#000000",
    "strokeWidth": 1,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 9,
    "targetFill": "$highlight",
    "targetStroke": "$accent",
    "targetStrokeWidth": 2,
    "targetColor": "none"
  },
  "<Pointer>": {
    "stroke": "#000000",
    "strokeWidth": 1,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 9,
    "targetFill": "$highlight",
    "targetStroke": "$accent",
    "targetStrokeWidth": 2,
    "targetColor": "none"
  },
  "$second": {
    "fill": "#FFFFFF",
    "stroke": "#000000",
    "strokeWidth": 1,
    "strokeStyle": "dashed",
    "fillStyle": "hatched"
  },
  "<Listing>": {
    "syntax": "keywords",
    "places": "underline",
    "lit": {
      "fill": "#E6E6E6",
      "stroke": "none",
      "strokeWidth": 0,
      "strokeStyle": "solid",
      "radius": 0,
      "color": "none",
      "weight": "normal",
      "padding": 0
    }
  }
}
