{
  "$text": "#000000",
  "$font": "sans",
  "$surface": "#FFFFFF",
  "$accent": "#000000",
  "$highlight": "#F0E442",
  "$spacing": 0.25,
  "$radius": 4,
  "$lineWidth": 2,
  "scale": {
    "spacing": "0 0.25 0.5 1 1.5",
    "radius": "0 4 999",
    "type": "16 20 24 30",
    "line": "2 4",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#000000",
    "line": "#000000",
    "firstFill": "#F0E442",
    "secondFill": "#56B4E9"
  },
  "$Container": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "gap": 0.5,
    "align": "center",
    "justify": "start",
    "spacing": "slots"
  },
  "$Value": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Bar": {
    "fill": "#FFFFFF",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Vertex": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "bold",
    "padding": 0.5,
    "radius": 999,
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Text": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Code": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "mono",
    "textSize": 20,
    "weight": "bold",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "underline",
    "case": "normal"
  },
  "$Icon": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "icon": "circle-dot"
  },
  "$Pointed": {
    "fill": "$highlight",
    "stroke": "$accent",
    "strokeWidth": 4,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "overflow": "shown",
    "expand": 0,
    "scale": 1,
    "spread": 0,
    "offsetX": 0,
    "offsetY": 0
  },
  "$Link": {
    "stroke": "#000000",
    "strokeWidth": 2,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 12,
    "targetFill": "#F0E442",
    "targetStroke": "#000000",
    "targetStrokeWidth": 4,
    "targetColor": "none"
  },
  "$second": {
    "fill": "#56B4E9",
    "stroke": "#000000",
    "strokeWidth": 2,
    "strokeStyle": "dashed",
    "fillStyle": "solid"
  },
  "listing": {
    "syntax": "keywords",
    "places": "outline",
    "lit": {
      "fill": "#F0E442",
      "stroke": "#000000",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "radius": 0,
      "color": "none",
      "weight": "bold",
      "padding": 0
    }
  }
}
