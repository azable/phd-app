{
  "$text": "#1A1A1A",
  "$font": "sans",
  "$surface": "#FFFFFF",
  "$accent": "#D55E00",
  "$highlight": "#E69F00",
  "$spacing": 0.25,
  "$radius": 6,
  "$lineWidth": 2,
  "scale": {
    "spacing": "0 0.25 0.5 1 2",
    "radius": "0 6 999",
    "type": "20 24 30 36 48",
    "line": "2 3 4",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#1A1A1A",
    "line": "#333333",
    "firstFill": "#E69F00",
    "firstStroke": "#D55E00",
    "secondFill": "#CCE9F8",
    "muted": "#D9D9D9"
  },
  "<Container>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "gap": 0.5,
    "align": "center",
    "justify": "start",
    "spacing": "slots"
  },
  "<Value>": {
    "fill": "$surface",
    "stroke": "#333333",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 30,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Text>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Code>": {
    "fill": "#D9D9D9",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "mono",
    "textSize": 24,
    "weight": "normal",
    "padding": 0.25,
    "radius": 6,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "<Icon>": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 30,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "icon": "circle-dot"
  },
  "<Link>": {
    "stroke": "#333333",
    "strokeWidth": 3,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 12,
    "targetFill": "$highlight",
    "targetStroke": "$accent",
    "targetStrokeWidth": 4,
    "targetColor": "none"
  },
  "<Pointer>": {
    "stroke": "#333333",
    "strokeWidth": 3,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 12,
    "targetFill": "$highlight",
    "targetStroke": "$accent",
    "targetStrokeWidth": 4,
    "targetColor": "none"
  },
  "$second": {
    "fill": "#CCE9F8",
    "stroke": "#333333",
    "strokeWidth": 2,
    "strokeStyle": "solid",
    "fillStyle": "solid"
  },
  "<Listing>": {
    "syntax": "keywords",
    "places": "fill",
    "lit": {
      "fill": "#E69F00",
      "stroke": "none",
      "strokeWidth": 0,
      "strokeStyle": "solid",
      "radius": 6,
      "color": "none",
      "weight": "bold",
      "padding": 0
    }
  }
}
