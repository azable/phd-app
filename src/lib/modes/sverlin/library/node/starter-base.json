{
  "$text": "black",
  "$font": "sans",
  "$surface": "white",
  "$accent": "amber-500",
  "$highlight": "amber-100",
  "$spacing": 0.375,
  "$radius": 8,
  "$lineWidth": 1.5,
  "scale": {
    "spacing": "0 0.0625 0.125 0.25 0.375 0.5 0.75 1 1.5 2",
    "radius": "0 2 4 6 8 12 999",
    "type": "12 14 16 18 20 24 30 36 48",
    "line": "0.5 1 1.5 2 3 4",
    "opacity": "0.25 0.5 0.75 1"
  },
  "$Container": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 16,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "gap": 0.5,
    "align": "center",
    "justify": "start",
    "spacing": "slots"
  },
  "$Value": {
    "fill": "$surface",
    "stroke": "neutral-300",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Bar": {
    "fill": "neutral-300",
    "stroke": "neutral-500",
    "strokeWidth": 1,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "normal",
    "padding": 0,
    "radius": 2,
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Vertex": {
    "fill": "$surface",
    "stroke": "neutral-400",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 18,
    "weight": "bold",
    "padding": 0.5,
    "radius": 999,
    "minSize": 2.5,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Text": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 16,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Code": {
    "fill": "neutral-100",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "mono",
    "textSize": 16,
    "weight": "normal",
    "padding": 0.125,
    "radius": 4,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal"
  },
  "$Icon": {
    "fill": "none",
    "stroke": "none",
    "strokeWidth": 0,
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "normal",
    "padding": 0,
    "radius": 0,
    "minSize": 0,
    "width": "uniform",
    "height": "uniform",
    "xAnchor": "center",
    "yAnchor": "center",
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "icon": "circle-dot"
  },
  "$Pointed": {
    "fill": "$highlight",
    "stroke": "$accent",
    "strokeWidth": "$lineWidth",
    "strokeStyle": "solid",
    "opacity": 1,
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5,
    "shadow": "none",
    "glow": "none",
    "fillStyle": "solid",
    "decoration": "none",
    "case": "normal",
    "overflow": "shown",
    "expand": 0,
    "scale": 1,
    "spread": 0,
    "offsetX": 0,
    "offsetY": 0
  },
  "$Link": {
    "stroke": "neutral-500",
    "strokeWidth": 2,
    "opacity": 1,
    "strokeStyle": "solid",
    "route": "layout",
    "head": "arrow",
    "headSize": 9,
    "targetFill": "amber-100",
    "targetStroke": "amber-500",
    "targetStrokeWidth": 1.5,
    "targetColor": "none"
  },
  "$second": {
    "fill": "sky-100",
    "stroke": "neutral-500",
    "strokeWidth": 1.5,
    "strokeStyle": "solid",
    "fillStyle": "solid"
  },
  "listing": {
    "syntax": "keywords",
    "places": "fill",
    "lit": {
      "fill": "amber-200",
      "stroke": "none",
      "strokeWidth": 0,
      "strokeStyle": "solid",
      "radius": 2,
      "color": "none",
      "weight": "normal",
      "padding": 0
    }
  }
}
