{
  "$text": "#1A1A1A",
  "$font": "sans",
  "$surface": "#FFFFFF",
  "$accent": "#D55E00",
  "$highlight": "#E69F00",
  "$spacing": 0.25,
  "$radius": 6,
  "$lineWidth": 2,
  "scale": {
    "spacing": "0 0.25 0.5 1 2",
    "radius": "0 6 999",
    "type": "20 24 30 36 48",
    "line": "2 3 4",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#1A1A1A",
    "line": "#333333",
    "firstFill": "#E69F00",
    "firstStroke": "#D55E00",
    "secondFill": "#CCE9F8",
    "muted": "#D9D9D9"
  },
  "<Node>": {
    "color": "$text",
    "font": "$font",
    "textSize": 24,
    "gap": 0.5,
    "iconSize": 30
  },
  "<Code>": {
    "fill": "#D9D9D9",
    "color": "$text",
    "font": "mono",
    "textSize": 24,
    "padding": 0.25,
    "radius": 6
  },
  "<Link>": {
    "stroke": "#333333",
    "strokeWidth": 3,
    "headSize": 12,
    "<To>": {
      "head": "arrow",
      "fill": "$highlight",
      "stroke": "$accent",
      "strokeWidth": 4
    }
  },
  "$cell": {
    "fill": "$surface",
    "stroke": "#333333",
    "strokeWidth": "$lineWidth",
    "textSize": 30,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5
  },
  "$card": {
    "fill": "$surface",
    "stroke": "#333333",
    "strokeWidth": "$lineWidth",
    "radius": "$radius",
    "padding": "$spacing",
    "gap": 0.25
  },
  "$label": {
    "fill": "$surface",
    "strokeWidth": "$lineWidth",
    "textSize": 20,
    "weight": "bold"
  },
  "$caption": {
    "textSize": 20
  },
  "$second": {
    "fill": "#CCE9F8",
    "stroke": "#333333",
    "strokeWidth": 2
  },
  "<Listing>": {
    "syntax": "keywords",
    "places": "fill",
    "lit": {
      "fill": "#E69F00",
      "radius": 6,
      "weight": "bold"
    }
  }
}
