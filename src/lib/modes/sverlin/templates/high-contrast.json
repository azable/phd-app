{
  "$text": "#000000",
  "$font": "sans",
  "$surface": "#FFFFFF",
  "$accent": "#000000",
  "$highlight": "#F0E442",
  "$spacing": 0.25,
  "$radius": 4,
  "$lineWidth": 2,
  "scale": {
    "spacing": "0 0.25 0.5 1 1.5",
    "radius": "0 4 999",
    "type": "16 20 24 30",
    "line": "2 4",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#000000",
    "line": "#000000",
    "firstFill": "#F0E442",
    "secondFill": "#56B4E9"
  },
  "<Node>": {
    "color": "$text",
    "font": "$font",
    "textSize": 20,
    "gap": 0.5,
    "iconSize": 24
  },
  "<Code>": {
    "color": "$text",
    "font": "mono",
    "textSize": 20,
    "weight": "bold",
    "decoration": "underline"
  },
  "<Link>": {
    "stroke": "#000000",
    "strokeWidth": 2,
    "headSize": 12,
    "<To>": {
      "head": "arrow",
      "fill": "$highlight",
      "stroke": "$accent",
      "strokeWidth": 4
    }
  },
  "$cell": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "textSize": 24,
    "weight": "bold",
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5
  },
  "$card": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "radius": "$radius",
    "padding": "$spacing",
    "gap": 0.25
  },
  "$label": {
    "fill": "$surface",
    "strokeWidth": "$lineWidth",
    "textSize": 16,
    "weight": "bold"
  },
  "$caption": {
    "textSize": 16
  },
  "$second": {
    "fill": "#56B4E9",
    "stroke": "#000000",
    "strokeWidth": 2,
    "strokeStyle": "dashed"
  },
  "<Listing>": {
    "syntax": "keywords",
    "places": "outline",
    "lit": {
      "fill": "#F0E442",
      "stroke": "#000000",
      "strokeWidth": 2,
      "weight": "bold"
    }
  }
}
