{
  "$text": "#000000",
  "$font": "serif",
  "$surface": "#FFFFFF",
  "$accent": "#000000",
  "$highlight": "#E6E6E6",
  "$spacing": 0.25,
  "$radius": 0,
  "$lineWidth": 1,
  "scale": {
    "spacing": "0 0.125 0.25 0.5 1",
    "radius": "0 999",
    "type": "12 15 18 22",
    "line": "0.5 1 2",
    "opacity": "0.4 1"
  },
  "palette": {
    "page": "#FFFFFF",
    "text": "#000000",
    "line": "#000000",
    "first": "#E6E6E6"
  },
  "<Node>": {
    "color": "$text",
    "font": "$font",
    "textSize": 15,
    "gap": 0.5,
    "iconSize": 18
  },
  "<Code>": {
    "color": "$text",
    "font": "mono",
    "textSize": 15
  },
  "<Link>": {
    "stroke": "#000000",
    "strokeWidth": 1,
    "<To>": {
      "head": "arrow",
      "fill": "$highlight",
      "stroke": "$accent",
      "strokeWidth": 2
    }
  },
  "$cell": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "textSize": 18,
    "padding": "$spacing",
    "radius": "$radius",
    "minSize": 2.5
  },
  "$card": {
    "fill": "$surface",
    "stroke": "#000000",
    "strokeWidth": "$lineWidth",
    "radius": "$radius",
    "padding": "$spacing",
    "gap": 0.25
  },
  "$label": {
    "fill": "$surface",
    "strokeWidth": "$lineWidth",
    "textSize": 12
  },
  "$caption": {
    "textSize": 12
  },
  "$second": {
    "fill": "#FFFFFF",
    "stroke": "#000000",
    "strokeWidth": 1,
    "strokeStyle": "dashed",
    "fillStyle": "hatched"
  },
  "<Listing>": {
    "syntax": "keywords",
    "places": "underline",
    "lit": {
      "fill": "#E6E6E6"
    }
  }
}
