<script lang="sverlin" domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Distance = type('integer', { min: 0, max: 99 });
  const Weight = type('integer', { min: 1, max: 20 });
  const Infinity = type(['∞']);
  const Dist = union(Distance, Infinity);
  const None = type(['none']);
  const PreviousName = union(Name, None);
  const VisitedFlag = type('boolean');
  const Flag = type('boolean');

  const Vertex = record({ name: Name });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Choice = union(VertexRef, None);
  const Distances = collection(Dist);
  const Previous = collection(PreviousName);
  const Visited = collection(VisitedFlag);

  const Neighbour = record({ to: VertexRef, weight: Weight });
  const Neighbours = collection(Neighbour);
  const Slot = index(Neighbours);
  const Adjacency = collection(Neighbours);

  const Length = unop((v: Vertices) => VertexRef(v.length));
  const Before = binop((a: VertexRef, b: VertexRef) => Flag(a < b));
  const Next = unop((p: VertexRef) => VertexRef(p + 1));
  const Count = unop((n: Neighbours) => Slot(n.length));
  const Within = binop((a: Slot, b: Slot) => Flag(a < b));
  const Step = unop((p: Slot) => Slot(p + 1));
  const NotVisited = unop((v: VisitedFlag) => Flag(!v));
  const Reachable = unop((d: Dist) => Flag(d !== '∞'));
  const IsVertex = unop((p: Choice) => Flag(p !== 'none'));
  const IsNone = unop((p: Choice) => Flag(p === 'none'));
  const Shorter = binop((a: Dist, b: Dist) => Flag(a !== '∞' && (b === '∞' || a < b)));
  const AddWeight = binop((d: Dist, w: Weight) => Dist(d === '∞' ? '∞' : d + Distance(w)));
</script>

<script lang="sverlin" input>
  const vertices = Vertices([
    { name: 'A' },
    { name: 'B' },
    { name: 'C' },
    { name: 'D' },
    { name: 'E' }
  ]);
  const source = VertexRef(0);
  const adjacency = Adjacency([
    [{ to: 1, weight: 4 }, { to: 2, weight: 2 }],
    [{ to: 0, weight: 4 }, { to: 2, weight: 1 }, { to: 3, weight: 5 }],
    [{ to: 0, weight: 2 }, { to: 1, weight: 1 }, { to: 3, weight: 8 }, { to: 4, weight: 10 }],
    [{ to: 1, weight: 5 }, { to: 2, weight: 8 }, { to: 4, weight: 2 }],
    [{ to: 2, weight: 10 }, { to: 3, weight: 2 }]
  ]);
</script>

<script lang="sverlin">
  @unknown[let distances = Distances(['∞', '∞', '∞', '∞', '∞']);
  let previous = Previous(['none', 'none', 'none', 'none', 'none']);
  let visited = Visited([false, false, false, false, false]);]
  @initial[distances[source] = Distance(0);]

  for (@firstRound[let round = VertexRef(0)]; @moreRounds[Before(round, Length(vertices))]; @nextRound[round = Next(round)]) @round{
    let current = Choice(None('none'));
    for (@firstVertex[let v = VertexRef(0)]; @moreVertices[Before(v, Length(vertices))]; @nextVertex[v = Next(v)]) @scan{
      if (@open[NotVisited(visited[v]) && Reachable(distances[v])]) {
        if (@unchosen[IsNone(current)]) @first{
          current = v;
        } else if (@shorter[Shorter(distances[v], distances[current])]) @better{
          current = v;
        }
      }
    }
    if (@chosen[IsVertex(current)]) @settle{
      const edges = adjacency[current];
      @mark[visited[current] = true;]
      for (@firstEdge[let slot = Slot(edges, 0)]; @moreEdges[Within(slot, Count(edges))]; @nextEdge[slot = Step(slot)]) @edge{
        const edge = edges[slot];
        const alternative = @sum[AddWeight(distances[current], edge.weight)];
        if (@improve[Shorter(alternative, distances[edge.to])]) @relax{
          distances[edge.to] = alternative;
          previous[edge.to] = vertices[current].name;
        }
      }
    }
  }
</script>

<script lang="sverlin" listing="textbook">
DIJKSTRA(graph, source)
@unknown[every distance = ∞, no predecessors, none visited]
@initial[distance[source] = 0]
@firstRound[round = 1]
while @moreRounds[round ≤ number of vertices]
  @round[@firstVertex[v = the first vertex]
  while @moreVertices[v is a vertex]
    @scan[if @open[v is unvisited and reachable]
      if @unchosen[no vertex is chosen]
        @first[choose v]
      else if @shorter[its distance is shorter]
        @better[choose v]]
    @nextVertex[v = the next vertex]
  if @chosen[a vertex is chosen]
    @settle[@mark[mark it settled]
    @firstEdge[e = its first edge]
    while @moreEdges[e is one of its edges]
      @edge[@sum[alternative = distance + edge weight]
      if @improve[alternative is shorter]
        @relax[update the neighbour's distance and predecessor]]
      @nextEdge[e = its next edge]]]
  @nextRound[round = round + 1]
</script>

{#snippet NameText(value: Name)}<Node value={value} />{/snippet}
{#snippet DistanceValue(value: Dist)}<Node value={value} />{/snippet}
{#snippet WeightText(value: Weight)}<Node value={value} />{/snippet}
{#snippet PreviousValue(value: PreviousName)}<Node value={value === 'none' ? '—' : value} />{/snippet}
{#snippet VisitedWord(value: VisitedFlag)}<Node>{value ? 'settled' : 'unsettled'}</Node>{/snippet}
{#snippet ScanMark(value: VertexRef)}<Pointed />{/snippet}

{#snippet Title()}
  <Node>Dijkstra’s shortest paths from {@render Name(vertices[source].name)}</Node>
{/snippet}

{#snippet Graph()}
  <Node layout="free">
    {#each vertices as vertex, k}
      {#snippet DistanceLine()}<Node>distance {@render Dist(distances[k])}</Node>{/snippet}
      {#snippet PreviousLine()}<Node>via {@render PreviousName(previous[k])}</Node>{/snippet}
      <Node layout="column">
        {@render Name(vertex.name)}
        {@render DistanceLine()}
        {@render PreviousLine()}
        {@render VisitedFlag(visited[k])}
      </Node>
    {/each}
    {#each vertices as vertex, k}
      {#each adjacency[k] as neighbour}
        <Link from={k} to={neighbour.to}>{@render Weight(neighbour.weight)}</Link>
      {/each}
    {/each}
  </Node>
{/snippet}

{#snippet Key()}
  <Node>Each edge label is its weight. “Via” records the predecessor on the best route found so far.</Node>
{/snippet}

{#snippet Board()}
  <Node layout="row">
    <Listing />
    <Node layout="column">
      {@render Graph()}
      {@render Key()}
    </Node>
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Board()}
    {@render VertexRef(v)}
  </Node>
</Layout>
