<script domain>
  const Name = type(['A', 'B', 'C', 'D', 'E', 'F']);
  const Seen = type('boolean');
  const Vertex = record({ name: Name, seen: Seen });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Neighbours = collection(VertexRef);
  const Slot = index(Neighbours);
  const Adjacency = collection(Neighbours);
  const Queue = collection(VertexRef);
  const VisitOrder = collection(VertexRef);

</script>

<script input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false },
    { name: 'F', seen: false }
  ]);
  const adjacency = Adjacency([
    [1, 2],
    [3, 4],
    [4],
    [5],
    [5],
    []
  ]);
</script>

<script algorithm>
  @init[let queue = Queue([0]);
  let order = VisitOrder([]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    queue.shift();
    order.push(current);
    const around = adjacency[current];]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const neighbour = around[slot];
      if (@check[!vertices[@next[neighbour]].seen]) @add{
        vertices[neighbour].seen = true;
        queue.push(neighbour);
      }
    }
  }
</script>

<script listing="textbook">
BFS(start)
  @init[queue = [start]]
  while @more[queue is not empty]
    @visit[@take[current = remove front of queue
    record current as visited]
    @first[slot = the first neighbour of current]
    while @another[slot is a neighbour]
      @look[neighbour = neighbour slot
      if @check[@next[neighbour] has not been seen]
        @add[mark neighbour as seen
        add neighbour to the queue]]
      @step[slot = the next neighbour]]
</script>

{#snippet NameText(value: Name)}<Node value={value} />{/snippet}
{#snippet SeenWord(value: Seen)}<Node>{value ? 'seen' : 'unseen'}</Node>{/snippet}
{#snippet VertexNumber(value: VertexRef)}<Node value={value} />{/snippet}

{#snippet VertexCard(vertex: Vertex)}
  <Node layout="column">
    {vertex.name}
    {vertex.seen}
  </Node>
{/snippet}

{#snippet QueueItems(items: Queue)}
  <Node>{#each items as item}{item}{/each}</Node>
{/snippet}

{#snippet OrderItems(items: VisitOrder)}
  <Node>{#each items as item}{item}{/each}</Node>
{/snippet}

{#snippet PositionMark(value: VertexRef)}<Pointed />{/snippet}

{#snippet Title()}
  <Node>Breadth-first search from A</Node>
{/snippet}

{#snippet Graph()}
  <Node layout="free">
    {#each vertices as vertex, k}
      {#snippet IndexLabel()}<Node>{k}</Node>{/snippet}
      <Node layout="column">
        {vertex}
        {@render IndexLabel()}
      </Node>
      {#each adjacency[k] as neighbour}
        <Link from={k} to={neighbour} />
      {/each}
    {/each}
  </Node>
{/snippet}

{#snippet QueueLine()}
  <Node layout="row">
    <Node>queue</Node>
    {queue}
  </Node>
{/snippet}

{#snippet OrderLine()}
  <Node layout="row">
    <Node>visit order</Node>
    {order}
  </Node>
{/snippet}

{#snippet CurrentInfo()}
  <Node>removing vertex {current} and exploring its neighbours</Node>
{/snippet}

{#snippet NeighbourInfo()}
  <Node>checking neighbour {@visit.look.check.next}</Node>
{/snippet}

{#snippet StatePanel()}
  <Node layout="column">
    {@render QueueLine()}
    {@render OrderLine()}
    {@render CurrentInfo()}
    {@render NeighbourInfo()}
  </Node>
{/snippet}

{#snippet Lesson()}
  <Node layout="row">
    <Listing />
    <Node layout="column">
      {@render Graph()}
      {@render StatePanel()}
    </Node>
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Lesson()}
    {current}
    {@visit.look.check.next}
  </Node>
</Layout>
