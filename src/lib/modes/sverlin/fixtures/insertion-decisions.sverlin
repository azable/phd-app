<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 5 });
  const Position = index(Values);
</script>

<script input>
  const values = Values;
</script>

<script algorithm>
  for (
    @start[let i = Position(1)];
    @more[i < values.length];
    @next[i++]
  ) @insert{
    @init[let j = i;]
    while (@front[j > 0]) @scan{
      if (@cmp[values[j - 1] > values[j]]) @swap{
        @exchange[
          const held = values[j - 1];
          values[j - 1] = values[j];
          values[j] = held;
        ]
        @down[j--;]
      } else @stop{
        break;
      }
    }
  }
</script>

<script listing="textbook">
  INSERTION SORT(A)
  for i = 1 to length(A) - 1
      @init[j = i]
      while @front[j > 0]
          if @cmp[A[j - 1] > A[j]]
              @swap[@exchange[swap A[j - 1] and A[j]]
              @down[j = j - 1]]
          else @stop[stop]
</script>

<View of="Int" name="IntColumn">
  <Node layout="column">
    <Node kind="ColumnLength" height={this} />
    <Node value={this} />
  </Node>
</View>
<View of="Position" name="Mark">
  <Node layout="column"><Pointed /><Node kind="Tip" icon /><Node kind="Caption">{place()}</Node></Node>
</View>
<View of="@insert.scan.cmp" name="Ask">
  <Node>is {this.left} > {this.right}? {this.value ? 'yes, so swap' : 'no, so the round stops'}</Node>
</View>
<View of="@insert.front" name="Front">
  <Node>{this.value ? 'j > 0, so compare' : 'j is at the front, so the round stops'}</Node>
</View>

<Layout name="Cells" of="values, i">
  <Node layout="row">
    {#each values as v, k}
      {#if k < i}<Node kind="Sorted">{v}</Node>{:else}<Node kind="Unsorted">{v}</Node>{/if}
    {/each}
  </Node>
</Layout>
<Layout name="Board">
  <Node layout="row">
    <Listing />
    <Node layout="column">
      <Cells />
      <Node layout="stack">
        <Node when="@insert.init">the cells left of i are sorted; insert the one at i</Node>
        <Node when="@insert.front">{@insert.front}</Node>
        <Node when="@insert.scan.cmp">{@insert.scan.cmp}</Node>
        <Node when="@insert.scan.swap">swapped; j follows the item being inserted</Node>
      </Node>
    </Node>
  </Node>
</Layout>
<Layout name="Main" of="values, i, j">
  <Node>
    <Board />
    {i}
    {j}
  </Node>
</Layout>

<Case name="main" values={[5, 2, 4, 1, 3]} />
<Storyboard>
  <Scene name="sort" case="main" pause="@insert.init, @insert.front, @insert.scan.cmp, @insert.scan.swap">
    <Main />
  </Scene>
</Storyboard>
