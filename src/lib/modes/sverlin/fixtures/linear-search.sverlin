<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 6 });
  const Index = index(Values);
</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @start[let i = Index(values, 0);]
  for (; @more[i < values.length]; @next[i++]) @scan{
    if (@check[values[i] === target]) @found{
      return;
    }
  }
  @missing[return;]
</script>

<script listing="textbook">
LINEAR-SEARCH(A, target)
1  @start[start at i = 0]
2  @more[while i is inside A]
3      @scan.check[if A[:i[i]] = target]
4          @scan.found[return :i[i]]
5      @next[i = i + 1]
6  @missing[return not found]
</script>

<View of="Int" name="IntCell">
  <Node value={this} />
</View>

<View of="Index" name="Arrow">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>

<View of="@scan.check" name="Comparison">
  <Node>
    Is {this.left} equal to {this.right}? {this.value}
  </Node>
</View>

<Layout name="Heading" of="target">
  <Node kind="Title">Linear search for {target}</Node>
</Layout>

<Layout name="SearchRow" of="values, i">
  <Node kind="Board" layout="grid">
    {#each values as value, k}
      <Node kind="Item" layout="column" row={0} col={k}>
        {value}
        <Node kind="IndexLabel">{k}</Node>
      </Node>
    {/each}
    <Node kind="Lane" row={1} col={i}>{i}</Node>
  </Node>
</Layout>

<Layout name="Status" of="target, i, @scan.check, @scan.found, @missing">
  <Node layout="column">
    <Node layout="stack">
      <Node when="@scan.check">
        {@scan.check}
      </Node>
      <Node when="@scan.found" kind="Outcome" layout="row">
          <Node>Found {target} at index</Node>
          <Node kind="Number" value={i} />
        </Node>
      <Node when="@missing" kind="Outcome">{target} is not in the array.</Node>
    </Node>
  </Node>
</Layout>

<Layout
  name="Stacked"
  of="values, target, i, @scan.check, @scan.found, @missing"
>
  <Node layout="column">
    <Heading target={target} />
    <Node layout="row">
      <Listing />
      <Node layout="column">
        <SearchRow values={values} i={i} />
        <Status target={target} i={i} />
      </Node>
    </Node>
  </Node>
</Layout>

<Case
  name="absent"
  values={[7, 2, 9, 4, 6, 1]}
  target={8}
/>

<Storyboard>
  <Scene
    name="search"
    case="absent"
    pause="@scan.check, @scan.found, @missing"
  >
    <Stacked values={values} target={target} i={i} />
  </Scene>
</Storyboard>
