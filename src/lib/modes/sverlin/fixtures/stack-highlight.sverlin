<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 6 });
  const Index = index(Values);
</script>
<script input>
  const values = Values;
</script>
<script algorithm>
  @begin[let sorted = Index(values, 1);]
  for (@first[let i = Index(values, 1)]; @more[i < values.length]; @next[i++]) @pass{
    @key[const key = values[i];]
    @init[let j = i;]
    while (@test[j > 0 && values[j - 1] > key]) @shift{
      values[j] = values[j - 1];
      j--;
    }
    @put[values[j] = key; sorted++;]
  }
</script>
<View of="Int" name="Cell"><Node value={this} /></View>
<View of="Index" name="Mark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>
<Layout name="Board" of="values, sorted, key, j, @next">
  <Node layout="column">
    <Node layout="grid">
      {#each values as v, k}{#if k < sorted}<Node kind="Sorted" layout="stack" row={0} col={k}><When of="@next"><Node kind="SortedMark"></Node></When>{v}</Node>{:else}<Node kind="Unsorted" row={0} col={k}>{v}</Node>{/if}{/each}
      <Node kind="Lane" row={1} col={j}>{j}</Node>
    </Node>
    <Node kind="KeyRow" layout="row"><Node>:key[key]</Node>{key}</Node>
  </Node>
</Layout>
<Layout name="Story" of="values, sorted, key, j, @next">
  <Node layout="column">
    <Board values={values} sorted={sorted} key={key} j={j} />
    <OneOf>
      <When of="@next"><Node kind="Note">The blue part is always sorted. Each pass adds one more value to it.</Node></When>
      <When of=":after"><Node kind="Note">Pass i compares the key with at most i values, so n passes take about n²/2 comparisons: O(n²) time.</Node></When>
    </OneOf>
  </Node>
</Layout>
<Case name="main" values={[31, 12, 25, 8, 17, 4]} />
<Storyboard>
  <Scene name="sort" case="main" pause="@pass.key, @pass.shift, @pass.put, @next"><Story values={values} sorted={sorted} key={key} j={j} /></Scene>
</Storyboard>
