<script lang="sverlin" domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Flag = type('boolean');

  const Count = unop((n: Out) => Slot(n.length));
  const Within = binop((a: Slot, b: Slot) => Flag(a < b));
  const Step = unop((p: Slot) => Slot(p + 1));
  const Vertex = record({ name: Name, seen: Flag });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Out = collection(VertexRef);
  const Slot = index(Out);
  const Adjacency = collection(Out);
  const Queue = collection(VertexRef);

  const Waiting = unop((q: Queue) => Flag(q.length > 0));
  const Not = unop((f: Flag) => Flag(!f));
  const Append = binop((q: Queue, v: VertexRef) => Queue([...q, v]));
  const Rest = unop((q: Queue) => Queue(q.slice(1)));
</script>

<script lang="sverlin" input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false }
  ]);
  const out = Adjacency([[1, 2], [3], [3], [4], []]);
</script>

<script lang="sverlin">
  @init[let queue = Queue([0]);]
  while (@more[Waiting(queue)]) @visit{
    @take[const current = queue[0];
    queue = Rest(queue);
    const around = out[current];]
    for (@first[let slot = Slot(around, 0)]; @another[Within(slot, Count(around))]; @step[slot = Step(slot)]) @look{
      const w = around[slot];
      if (@check[Not(vertices[@next[w]].seen)]) @add{
        vertices[w].seen = true;
        queue = Append(queue, w);
      }
    }
  }
</script>

{#snippet NameText(name: Name)}<Node value={name} />{/snippet}
{#snippet SeenMark(seen: Flag)}<Node>{seen ? '✓' : '·'}</Node>{/snippet}
{#snippet VertexCard(v: Vertex)}<Node layout="column">{v.name}{v.seen}</Node>{/snippet}
{#snippet RefCard(v: VertexRef)}<Node value={v} />{/snippet}
{#snippet QueueItems(q: Queue)}<Node>{#each q as v}{v}{/each}</Node>{/snippet}
{#snippet Marked(v: VertexRef)}<Pointed />{/snippet}
{#snippet Graph()}
  <Node layout="free">
    {#each vertices as v, k}
      {#snippet VertexNumber()}<Node>{k}</Node>{/snippet}
      <Node layout="column">{v}{@render VertexNumber()}</Node>
      {#each out[k] as w}<Link from={k} to={w} />{/each}
    {/each}
  </Node>
{/snippet}
{#snippet QueueLine()}<Node>queue {queue}</Node>{/snippet}

<Layout name="Main">
  <Node>
    {@render Graph()}
    {@render QueueLine()}
    {current}
    {@visit.look.check.next}
  </Node>
</Layout>
