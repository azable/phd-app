<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 6 });
  const Index = index(Values);
</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  for (
    @start[let i = Index(values, 0)];
    @more[i < values.length];
    @next[i++]
  ) @scan{
    if (@check[values[i] === target]) @found{
      return;
    }
  }
  @missing[return;]
</script>

<script listing="textbook">
LINEAR-SEARCH(A, target)
1  @start[start at i = 0]
2  @more[while i is inside A]
3      @scan.check[if A[:i[i]] = target]
4          @scan.found[return :i[i]]
5      @next[i = i + 1]
6  @missing[return not found]
</script>

<View of="Int" name="IntCell">
  <Node value={this} />
</View>

<View of="Index" name="ScanMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="PointerLabel">i</Node>
  </Node>
</View>

<View of="Index" name="IndexNumber">
  <Node value={this} />
</View>

<View of="@scan.check" name="Comparison">
  <Node>
    Is {this.left} equal to {this.right}? {this.value}
  </Node>
</View>

<Layout name="Heading">
  <Node kind="Title">Linear search for {target}</Node>
</Layout>

<Layout name="SearchRow">
  <Node layout="grid">
    {#each values as value, k}
      <Node row={0} col={k}>{value}</Node>
    {/each}
    <Node kind="Lane" row={1} col={i}>{i}</Node>
  </Node>
</Layout>

<Layout name="Status">
  <Node layout="column">
    <Node layout="stack">
      <Node when="@scan.check">
        {@scan.check}
      </Node>
      <Node when="@scan.found">
        <Node kind="Outcome" layout="row">
          <Node>Found {target} at index</Node>
          <Node kind="Number" value={i} />
        </Node>
      </Node>
      <Node when="@missing">
        <Node kind="Outcome">{target} is not in the array.</Node>
      </Node>
    </Node>
  </Node>
</Layout>

<Layout
  name="Stacked"
>
  <Node layout="column">
    <Heading />
    <Node layout="row">
      <Listing />
      <Node layout="column">
        <SearchRow />
        <Status />
      </Node>
    </Node>
  </Node>
</Layout>

<Case
  name="present"
  values={[7, 2, 9, 4, 6, 1]}
  target={6}
/>

<Storyboard>
  <Scene
    name="search"
    case="present"
    pause="@scan.check.end, @scan.found.end, @missing.end"
  >
    <Stacked />
  </Scene>
</Storyboard>
