<script domain>
  const Int = type('integer', { min: 0, max: 40 });
  const Values = array(Int, { max: 7 });
  const Index = index(Values);
</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @range[
    let lo = Index(values, 0);
    let hi = Index(values, values.length - 1);
  ]
  while (@open[lo <= hi]) @probe{
    const mid = Index(
      values,
      Math.floor((lo + hi) / 2)
    );
    if (@equal[values[mid] === target]) @found{
      return;
    }
    if (@below[values[mid] < target]) @right{
      lo = mid + 1;
    } else @left{
      hi = mid - 1;
    }
  }
  @missing[return;]
</script>

<script listing="textbook">
  BINARY-SEARCH(A, target)
  @range[lo = 0; hi = length(A) - 1]
  while lo <= hi
      @probe[mid = floor((lo + hi) / 2)
      @equal[if A[mid] = target]
          @found[return mid]
      if A[mid] < target
          @right[lo = mid + 1]
      else
          @left[hi = mid - 1]]
  @missing[return not found]
</script>

<View of="Int" name="IntCell">
  <Node value={this} />
</View>
<View of="Int" name="IntBar">
  <Node layout="column">
    <Node kind="Length" height={this} />
    <Node kind="BarLabel" value={this} />
  </Node>
</View>
<View of="Index" name="LowMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="LowLabel">lo</Node>
  </Node>
</View>
<View of="Index" name="MidMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="MidLabel">mid</Node>
  </Node>
</View>
<View of="Index" name="HighMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="HighLabel">hi</Node>
  </Node>
</View>
<View of="Index" name="IndexText">
  <Node value={this} />
</View>
<View of="@probe.equal" name="EqualityQuestion">
  <Node>
    Is {this.left} equal to {this.right}? {this.value}
  </Node>
</View>

<Layout name="Title">
  <Node>Binary search for {target}</Node>
</Layout>
<Layout name="Cells">
  <Node layout="grid">
    <Node kind="Lane" row={-1} col={mid}>{mid}</Node>
    {#each values as value, k}
      <Node row={0} col={k}>{value}</Node>
    {/each}
    <Node kind="Lane" row={1} col={lo}>{lo}</Node>
    <Node kind="Lane" row={2} col={hi}>{hi}</Node>
  </Node>
</Layout>
<Layout name="Range">
  <Node layout="row">
    <Node>Remaining range: index</Node>
    <Node kind="Bound" value={lo} />
    <Node>to</Node>
    <Node kind="Bound" value={hi} />
  </Node>
</Layout>
<Layout name="Status">
  <Node>
    <Node layout="stack">
      <Node when="@probe.equal">
        {@probe.equal}
      </Node>
      <Node when="@probe.right">
        <Node>The middle value is too small, so search right.</Node>
      </Node>
      <Node when="@probe.left">
        <Node>The middle value is too large, so search left.</Node>
      </Node>
      <Node when="@probe.found">
        <Node layout="row">
          <Node>Found {target} at index</Node>
          <Node kind="Number" value={mid} />
        </Node>
      </Node>
      <Node when="@missing">
        <Node>{target} is not in the array.</Node>
      </Node>
    </Node>
  </Node>
</Layout>

<Layout name="Stacked">
  <Node layout="column">
    <Title />
    <Node layout="row">
      <Listing />
      <Node layout="column">
        <Cells />
        <Range />
        <Status />
      </Node>
    </Node>
  </Node>
</Layout>

<Case
  name="main"
  values={[2, 5, 8, 12, 16, 23, 38]}
  target={16}
/>

<Storyboard>
  <Scene
    name="search"
    case="main"
    pause="@range.end, @probe.equal.end, @probe.right.end, @probe.left.end,
      @probe.found.end, @missing.end"
  >
    <Stacked />
  </Scene>
</Storyboard>
