<script domain>
  const Int = type('integer', { min: 0, max: 40 });
  const Values = array(Int, { max: 7 });
  const Index = index(Values);
  const SearchStatus = type(['searching', 'not-found']);
  const SearchResult = union(Index, SearchStatus);
</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @range[let lo = Index(values, 0);
  let hi = Index(values, values.length - 1);
  let result = SearchResult(SearchStatus('searching'));]

  while (@open[lo <= hi]) @probe{
    const mid = Index(
      values,
      Math.floor((lo + hi) / 2)
    );

    if (@equal[values[mid] === target]) @found{
      result = mid;
      return;
    }

    if (@less[values[mid] < target]) @right{
      lo = mid + 1;
    } else @left{
      hi = mid - 1;
    }
  }

  @missing[result = SearchStatus('not-found');
  return;]
</script>

<script listing="textbook">
  BINARY-SEARCH(A, target)
  @range[lo = 0; hi = length(A) - 1]
  while lo <= hi
      mid = floor((lo + hi) / 2)
      if @probe.equal[A[mid] = target]
          @probe.found[return mid]
      if A[mid] < target
          @probe.right[lo = mid + 1]
      else
          @probe.left[hi = mid - 1]
  @missing[return not found]
</script>

<View of="Int" name="IntCell">
  <Node value={this} />
</View>

<View of="Values" name="Cells">
  <Node>
    {#each this as value}
      {value}
    {/each}
  </Node>
</View>

<View of="Values" name="Bars">
  <Node layout="row">
    {#each this as value}
      <Node kind="BarItem" layout="column">
        <Node kind="Bar" height={value} />
        <Node kind="BarLabel" value={value} />
      </Node>
    {/each}
  </Node>
</View>

<View of="Index" name="Lower">
  <Node layout="column">
    <Link to={this} />
    <Node kind="LowerLabel">lo</Node>
  </Node>
</View>

<View of="Index" name="Middle">
  <Node layout="column">
    <Link to={this} />
    <Node kind="MiddleLabel">mid</Node>
  </Node>
</View>

<View of="Index" name="Upper">
  <Node layout="column">
    <Link to={this} />
    <Node kind="UpperLabel">hi</Node>
  </Node>
</View>

<View of="Index" name="IndexNumber">
  <Node value={this} />
</View>

<View of="SearchStatus" name="StatusWord">
  <Node>
    {#if this === 'searching'}
      searching
    {:else}
      not found
    {/if}
  </Node>
</View>

<Layout name="Title">
  <Node>Binary search for {target}</Node>
</Layout>

<Layout name="ArrayLine">
  <Node layout="column">
    {values}
    <Node kind="Marks" layout="row">
      <Node>{lo}</Node>
      <Node>{mid}</Node>
      <Node>{hi}</Node>
    </Node>
  </Node>
</Layout>

<Layout name="RangeNote">
  <Node layout="row">
    <Node>Active range: index</Node>
    <Node kind="Bound" value={lo} />
    <Node>through</Node>
    <Node kind="Bound" value={hi} />
  </Node>
</Layout>

<Layout name="Explanation">
  <Node layout="column">
    <Node layout="stack">
      <Node when="@probe.equal">
        <Node layout="row">
          <Node>Compare {target} with {values[mid]} at index</Node>
          <Node kind="Number" value={mid} />
        </Node>
      </Node>
      <Node when="@probe.right">
        <Node>The target is larger, so move lo to the right.</Node>
      </Node>
      <Node when="@probe.left">
        <Node>The target is smaller, so move hi to the left.</Node>
      </Node>
      <Node when="@probe.found">
        <Node layout="row">
          <Node>Found {target} at index</Node>
          <Node kind="Number" value={mid} />
        </Node>
      </Node>
      <Node when="@missing">
        <Node>{target} is not in the array.</Node>
      </Node>
      <Node when=":after">
        <Node>Search result: {result}</Node>
      </Node>
    </Node>
  </Node>
</Layout>

<Layout name="Board">
  <Node layout="column">
    <Title />
    <ArrayLine />
    <RangeNote />
    <Explanation />
  </Node>
</Layout>

<Layout name="SideBySide">
  <Node layout="row">
    <Listing />
    <Board />
  </Node>
</Layout>

<Case
  name="main"
  values={[3, 8, 12, 17, 23, 31, 38]}
  target={31}
/>

<Storyboard>
  <Scene
    name="search"
    case="main"
    pause="@range, @probe.equal, @probe.right, @probe.left,
      @probe.found, @missing"
  >
    <SideBySide />
  </Scene>
</Storyboard>
