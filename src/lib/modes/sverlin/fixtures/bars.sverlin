<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 6 });
  const Position = index(Values);
</script>

<script input>
  const values = Values;
</script>

<script algorithm>
  for (@start[let pass = Position(0)]; @passes[pass < values.length - 1]; @nextPass[pass++]) @sweep{
    for (@first[let j = Position(0)]; @inner[j < values.length - 1 - pass]; @next[j++]) @pair{
      if (@test[values[j] > values[j + 1]]) @swap{
        const moved = values[j];
        values[j] = values[j + 1];
        values[j + 1] = moved;
      }
    }
  }
</script>

<View of="Int" name="Bar"><Node height={this} /></View>
<View of="Position" name="Here">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>

<Layout name="Bars" of="values, j">
  <Node layout="grid">
    {#each values as v, k}<Node row={0} col={k}>{v}</Node>{/each}
    <Node kind="Lane" row={1} col={j}>{j}</Node>
  </Node>
</Layout>

<Layout name="Main" of="j, values">
  <Node><Bars values={values} j={j} /></Node>
</Layout>

<Case name="main" values={[6, 2, 9, 4, 0, 7]} />

<Storyboard>
  <Scene name="main" case="main" pause="@sweep, @sweep.first, @sweep.next, @sweep.pair.swap"><Main j={j} values={values} /></Scene>
</Storyboard>
