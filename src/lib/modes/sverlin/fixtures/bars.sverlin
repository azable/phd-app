<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 6 });
  const Position = index(Values);
</script>

<script input>
  const values = Values;
</script>

<script algorithm>
  for (@start[let pass = Position(0)]; @passes[pass < values.length - 1]; @nextPass[pass++]) @sweep{
    for (@first[let j = Position(0)]; @inner[j < values.length - 1 - pass]; @next[j++]) @pair{
      if (@test[values[j] > values[j + 1]]) @swap{
        const moved = values[j];
        values[j] = values[j + 1];
        values[j + 1] = moved;
      }
    }
  }
</script>

<View of="Int" name="Bar"><Node height={this} /></View>
<View of="Position" name="Here"><Pointed /></View>

<Layout name="Bars" of="values"><Node layout="row">{#each values as v}{v}{/each}</Node></Layout>

<Layout name="Main" of="j, values">
  <Node><Bars values={values} />{j}</Node>
</Layout>

<Run name="main" values={[6, 2, 9, 4, 0, 7]} />

<Storyboard>
  <Scene name="main" run="main" pause="@sweep, @sweep.first, @sweep.next, @sweep.pair.swap"><Main j={j} values={values} /></Scene>
</Storyboard>
