<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 6 });
  const Index = index(Values);
</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @start[let i = Index(values, 0);]
  while (@more[i < values.length]) @scan{
    if (@hit[values[i] === target]) @found{ return; }
    @next[i++;]
  }
  @missing[return;]
</script>

<script listing="python">
def linear_search(values, target):
    @start[:i[i] = 0]
    while @more[:i[i] < len(values)]:
        @scan[if @hit[values[:i[i]] == target]:
            @found[return :i[i]]  # found it
        @next[:i[i] += 1]]
    @missing[return None]
</script>

<View of="Int" name="Cell"><Node value={this} /></View>
<View of="Index" name="Mark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>

<Layout name="Search">
  <Node layout="row">
    <Listing />
    <Node layout="grid">
      {#each values as v, k}<Node row={0} col={k}>{v}</Node>{/each}
      <Node kind="Lane" row={1} col={i}>{i}</Node>
    </Node>
  </Node>
</Layout>

<Case name="main" values={[4, 9, 2, 7, 5]} target={7} />

<Storyboard>
  <Scene name="search" case="main" pause="@more, @scan.hit, @scan.next"><Search /></Scene>
</Storyboard>
