<script lang="sverlin" domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Seen = type('boolean');
  const Vertex = record({ name: Name, seen: Seen });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Neighbours = collection(VertexRef);
  const Slot = index(Neighbours);
  const Adjacency = collection(Neighbours);
  const Queue = collection(VertexRef);

</script>

<script lang="sverlin" input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false }
  ]);
  const neighbours = Adjacency([[1, 2], [3], [3], [4], []]);
  const start = VertexRef(0);
</script>

<script lang="sverlin">
  @init[let queue = Queue([start]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    const around = neighbours[current];]
    @remove[queue.shift();]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const w = around[slot];
      if (@unseen[!vertices[w].seen]) @add{
        vertices[w].seen = true;
        queue.push(w);
      }
    }
  }
</script>

{#snippet NameText(value: Name)}<Node {value} />{/snippet}
{#snippet SeenWord(value: Seen)}<Node>{value ? 'seen' : 'unseen'}</Node>{/snippet}
{#snippet VertexCard(vertex: Vertex)}
  <Node layout="column">
    {vertex.name}
    {vertex.seen}
  </Node>
{/snippet}

{#snippet VertexNumber(p: VertexRef)}<Node value={p} />{/snippet}
{#snippet VertexName(p: VertexRef)}{at(p).name}{/snippet}
{#snippet VertexMini(p: VertexRef)}{at(p)}{/snippet}

{#snippet QueueItems(items: Queue)}
  <Node>{#each items as item}{item}{/each}</Node>
{/snippet}

{#snippet Outline(p: VertexRef)}<Pointed />{/snippet}

{#snippet Title()}<Node>Breadth-first search from A</Node>{/snippet}
{#snippet Graph()}
  <Node layout="free">
    {#each vertices as vertex, k}
      {vertex}
      {#each neighbours[k] as w}
        <Link from={k} to={w} />
      {/each}
    {/each}
  </Node>
{/snippet}
{#snippet QueueLine()}
  <Node layout="row">
    <Node>queue</Node>
    {queue}
  </Node>
{/snippet}
{#snippet Board()}
  <Node layout="column">
    {@render Graph()}
    {@render QueueLine()}
  </Node>
{/snippet}
{#snippet Taken()}
  <Node layout="row">
    <Node>current</Node>
    {current}
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Board()}
    {@render Taken()}
  </Node>
</Layout>
