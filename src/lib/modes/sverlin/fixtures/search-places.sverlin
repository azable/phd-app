<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 8 });
  const Index = index(Values);
  const Flag = type('boolean');
</script>
<script input>
  const values = Values;
  const target = Int;
</script><Case name="main" values={[3, 8, 15, 23, 42, 57, 71]} target={42} />
<script algorithm>
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = @mid[Index(Math.floor((lo + hi) / 2))];
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>
<script listing="pseudocode">
  @range[:lo[lo] = 0, :hi[hi] = length(A) - 1]
  while @open[:lo[lo] <= :hi[hi]]
    @probe[@mid[:mid[mid] = (:lo[lo] + :hi[hi]) / 2]
    if @low[:mid[A[mid]] < :target[target]]
      @right[:lo[lo] = :mid[mid] + 1]
    else
      @left[:hi[hi] = :mid[mid] - 1]]
</script>
<View of="Int" name="IntCell"><Node value={this} /></View>
<View of="Index" name="Arrow">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>
<Layout name="Cells" of="values, lo, hi, mid">
  <Node layout="grid">
    {#each values as v, k}<Node row={0} col={k}>{v}</Node>{/each}
    <Node kind="Lane" row={1} col={lo}>{lo}</Node>
    <Node kind="Lane" row={2} col={mid}>{mid}</Node>
    <Node kind="Lane" row={3} col={hi}>{hi}</Node>
  </Node>
</Layout>
<Layout name="Goal" of="target"><Node>target {target}</Node></Layout>
<Layout name="Main" of="lo, hi, mid, target, values">
  <Node layout="row">
    <Listing />
    <Node layout="column"><Goal target={target} /><Cells values={values} lo={lo} hi={hi} mid={mid} /></Node>
  </Node>
</Layout>

<Storyboard>
  <Scene name="main" case="main"><Main lo={lo} hi={hi} mid={mid} target={target} values={values} /></Scene>
</Storyboard>
