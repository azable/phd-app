<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = collection(Int);
  const Position = index(Values);

</script>

<script input>
  const values = Values([5, 1, 4, 2, 3]);
</script>

<script algorithm>
  for (@last[let end = values.length]; @more[Position(1) < end]; @shrink[end--]) @pass{
    for (@first[let i = Position(1)]; @inside[i < end]; @step[i++]) @pair{
      if (@compare[(values[@left[i - 1]]) > values[@right[i]]]) @swap{
        const moved = values[@from[i - 1]];
        values[i - 1] = values[@to[i]];
        values[i] = moved;
      }
    }
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}
{#snippet CompareMark(p: Position)}<Pointed />{/snippet}
{#snippet SwapMark(p: Position)}<Pointed />{/snippet}
{#snippet Ask(c: @pass.pair.compare)}
  <Node>compare {c.left} and {c.right}</Node>
{/snippet}
{#snippet SwapNote()}<Node>Swap</Node>{/snippet}
{#snippet Title()}<Node>Bubble sort</Node>{/snippet}
{#snippet Cells(list: Values)}
  <Node>{#each list as v}{v}{/each}</Node>
{/snippet}
{#snippet Board()}
  <Node layout="column">
    {values}
    <When of="@pass.pair.swap">
      <Link from={@pass.pair.swap.from} to={@pass.pair.swap.to} />
    </When>
    {@pass.pair.compare}
    <When of="@pass.pair.swap">{@render SwapNote()}</When>
  </Node>
{/snippet}

<Layout name="Stacked">
  <Node>
    {@render Title()}
    {@render Board()}
    {@pass.pair.compare.left}
    {@pass.pair.compare.right}
    <When of="@pass.pair.swap">
      {@pass.pair.swap.from}
      {@pass.pair.swap.to}
    </When>
  </Node>
</Layout>

<Layout name="Side">
  <Node layout="row">
    <Node>{@render Title()}</Node>
    {@render Board()}
    {@pass.pair.compare.left}
    {@pass.pair.compare.right}
  </Node>
</Layout>
