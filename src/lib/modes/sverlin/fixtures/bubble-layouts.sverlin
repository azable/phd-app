<script domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = array(Int, { max: 5 });
  const Position = index(Values);

</script>

<script input>
  const values = Values;
</script>

<script algorithm>
  for (@last[let end = values.length]; @more[Position(1) < end]; @shrink[end--]) @pass{
    for (@first[let i = Position(1)]; @inside[i < end]; @step[i++]) @pair{
      if (@compare[(values[@left[i - 1]]) > values[@right[i]]]) @swap{
        const moved = values[@from[i - 1]];
        values[i - 1] = values[@to[i]];
        values[i] = moved;
      }
    }
  }
</script>

<View of="Int" name="IntCell"><Node value={this} /></View>
<View of="Position" name="CompareMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>
<View of="Position" name="SwapMark">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>
<View of="@pass.pair.compare" name="Ask">
  <Node>compare {this.left} and {this.right}</Node>
</View>
<Layout name="SwapNote"><Node>Swap</Node></Layout>
<Layout name="Title"><Node>Bubble sort</Node></Layout>
<View of="Values" name="Cells">
  <Node>{#each this as v}{v}{/each}</Node>
</View>
<Layout name="Board" of="values, @pass.pair.swap, @pass.pair.compare">
  <Node layout="column">
    {values}
    <Node kind="Marks" layout="row">
      <Node>{@pass.pair.compare.left}</Node>
      <Node>{@pass.pair.compare.right}</Node>
      <Node>{@pass.pair.swap.from}</Node>
      <Node>{@pass.pair.swap.to}</Node>
    </Node>
    <Link when="@pass.pair.swap" from={@pass.pair.swap.from} to={@pass.pair.swap.to} />
    {@pass.pair.compare}
    <Node when="@pass.pair.swap"><SwapNote /></Node>
  </Node>
</Layout>

<Layout name="Stacked" of="values, @pass.pair.swap, @pass.pair.compare">
  <Node>
    <Title />
    <Board values={values} />
  </Node>
</Layout>

<Layout name="Side" of="values, @pass.pair.swap, @pass.pair.compare">
  <Node layout="row">
    <Node><Title /></Node>
    <Board values={values} />
  </Node>
</Layout>

<Case name="main" values={[5, 1, 4, 2, 3]} />

<Storyboard>
  <Scene name="stacked" case="main" pause="@pass.pair.compare, @pass.pair.compare.left, @pass.pair.compare.right, @pass.pair.swap, @pass.pair.swap.from, @pass.pair.swap.to"><Stacked values={values} /></Scene>
  <Scene name="side" case="main" pause="@pass.pair.compare, @pass.pair.compare.left, @pass.pair.compare.right, @pass.pair.swap, @pass.pair.swap.from, @pass.pair.swap.to"><Side values={values} /></Scene>
</Storyboard>
