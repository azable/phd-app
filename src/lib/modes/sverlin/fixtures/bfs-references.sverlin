<script domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Flag = type('boolean');
  const Vertex = record({ name: Name, seen: Flag, out: Out });
  const VertexRef = ref(Vertex);
  const Out = collection(VertexRef, { max: 2 });
  const Slot = index(Out);
  const Queue = collection(VertexRef, { max: 2 });

</script>

<script input>
  const e = VertexRef(Vertex({ name: 'E', seen: false, out: [] }));
  const d = VertexRef(Vertex({ name: 'D', seen: false, out: [e] }));
  const b = VertexRef(Vertex({ name: 'B', seen: false, out: [d] }));
  const c = VertexRef(Vertex({ name: 'C', seen: false, out: [d] }));
  const a = VertexRef(Vertex({ name: 'A', seen: true, out: [b, c] }));
</script>

<script algorithm>
  @init[let queue = Queue([a]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    queue.shift();
    const around = current.out;]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const w = around[slot];
      if (@check[!@next[w].seen]) @add{
        w.seen = true;
        queue.push(w);
      }
    }
  }
</script>

<View of="Name" name="NameText"><Node value={this} /></View>
<View of="Flag" name="SeenMark"><Node>{this ? '✓' : '·'}</Node></View>
<View of="Vertex" name="VertexCard">
  <Node layout="column">{this.name}{this.seen}<Node kind="OutField">{#each this.out as w}<Link to={w} />{/each}</Node></Node>
</View>
<View of="VertexRef" name="Marked"><Pointed /></View>
<Layout name="Graph">
  <Node layout="free">{#each all(Vertex) as v}{v}{/each}</Node>
</Layout>

<Layout name="Line" of="queue"><Node>queue: {#each queue as q}{q.name}{/each}</Node></Layout>

<Layout name="Main" of="current, queue, @visit.look.check.next">
  <Node>
    <Graph />
    <Line queue={queue} />
    {current}
    {@visit.look.check.next}
  </Node>
</Layout>
