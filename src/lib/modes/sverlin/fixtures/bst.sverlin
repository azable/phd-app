<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Name = type(['end']);
  const TreeNode = record({ key: Int, left: Next, right: Next });
  const NodeRef = ref(TreeNode);
  const Next = union(NodeRef, Name);
  const Values = collection(Int);
  const Index = index(Values);

</script>

<script input>
  const values = Values([8, 3, 10, 1, 6, 14, 4, 7, 13]);
  const root = NodeRef(TreeNode({
    key: values[0],
    left: Next(Name('end')),
    right: Next(Name('end'))
  }));
</script>

<script algorithm>
  function insert(node, value) @insert{
    if (@direction[value < node.key]) {
      if (@leftChild[node.left !== 'end']) {
        @descend[insert(node.left, value);]
      } else @attach[node.left = NodeRef(TreeNode({ key: value, left: Next(Name('end')), right: Next(Name('end')) }));]
    } else {
      if (@rightChild[node.right !== 'end']) {
        @descend[insert(node.right, value);]
      } else @attach[node.right = NodeRef(TreeNode({ key: value, left: Next(Name('end')), right: Next(Name('end')) }));]
    }
  }

  for (@first[let i = Index(1)]; @more[i < values.length]; @advance[i++]) @sequence{
    const value = @pick[values[i]];
    insert(root, value);
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}
{#snippet EndMark(value: Name)}<Node>∅</Node>{/snippet}
{#snippet NextLink(value: NodeRef)}<Link to={value} />{/snippet}
{#snippet TreeCard(node: TreeNode)}
  <Node layout="column">
    <Node>{node.key}</Node>
    <Node layout="row">
      <Node layout="row"><Node>L</Node>{node.left}</Node>
      <Node layout="row"><Node>R</Node>{node.right}</Node>
    </Node>
  </Node>
{/snippet}
{#snippet Title()}<Node>Binary search tree insertion</Node>{/snippet}
{#snippet Heap()}
  <Node layout="free" flow="y">
    {#each all(TreeNode) as node}{node}{/each}
  </Node>
{/snippet}
{#snippet Status()}
  <Node>Insert next value {@sequence.pick}</Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Heap()}
    {@render Status()}
  </Node>
</Layout>
