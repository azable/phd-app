<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Name = type(['end']);
  const TreeNode = record({ key: Int, left: Next, right: Next });
  const TreeNodes = pool(TreeNode, { max: 9 });
  const NodeRef = ref(TreeNode);
  const Next = union(NodeRef, Name);
  const Values = array(Int, { max: 9 });
  const Index = index(Values);

</script>

<script input>
  const values = Values([8, 3, 10, 1, 6, 14, 4, 7, 13]);
  const nodes = TreeNodes();
  const root = NodeRef(nodes.add(TreeNode({
    key: values[0],
    left: Next(Name('end')),
    right: Next(Name('end'))
  })));
</script>

<script algorithm>
  function insert(nodes, node, value) @insert{
    if (@direction[value < node.key]) {
      if (@leftChild[node.left !== 'end']) {
        @descend[insert(nodes, node.left, value);]
      } else @attach[node.left = nodes.add(TreeNode({ key: value, left: Next(Name('end')), right: Next(Name('end')) }));]
    } else {
      if (@rightChild[node.right !== 'end']) {
        @descend[insert(nodes, node.right, value);]
      } else @attach[node.right = nodes.add(TreeNode({ key: value, left: Next(Name('end')), right: Next(Name('end')) }));]
    }
  }

  for (@first[let i = Index(1)]; @more[i < values.length]; @advance[i++]) @sequence{
    const value = @pick[values[i]];
    insert(nodes, root, value);
  }
</script>

<View of="Int" name="IntCell"><Node value={this} /></View>
<View of="Name" name="EndMark"><Node>∅</Node></View>
<View of="NodeRef" name="NextLink"><Link to={this} /></View>
<View of="TreeNode" name="TreeCard">
  <Node layout="column">
    <Node>{this.key}</Node>
    <Node layout="row">
      <Node layout="row"><Node>L</Node>{this.left}</Node>
      <Node layout="row"><Node>R</Node>{this.right}</Node>
    </Node>
  </Node>
</View>
<Layout name="Title"><Node>Binary search tree insertion</Node></Layout>
<Layout name="Tree" of="nodes">
  <Node layout="free" flow="y">
    {#each nodes as node}{node}{/each}
  </Node>
</Layout>
<Layout name="Status" of="@sequence.pick">
  <Node>Insert next value {@sequence.pick}</Node>
</Layout>

<Layout name="Main" of="nodes, @sequence.pick">
  <Node>
    <Title />
    <Tree nodes={nodes} />
    <Status />
  </Node>
</Layout>

<Storyboard>
  <Scene name="main" pause="@insert.attach, @sequence.pick"><Main nodes={nodes} /></Scene>
</Storyboard>
