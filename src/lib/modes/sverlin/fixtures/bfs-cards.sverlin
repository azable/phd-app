<script domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Seen = type('boolean');
  const Vertex = record({ name: Name, seen: Seen });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Neighbours = collection(VertexRef);
  const Slot = index(Neighbours);
  const Adjacency = collection(Neighbours);
  const Queue = collection(VertexRef);

</script>

<script input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false }
  ]);
  const neighbours = Adjacency([[1, 2], [3], [3], [4], []]);
  const start = VertexRef(0);
</script>

<script algorithm>
  @init[let queue = Queue([start]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    queue.shift();
    const around = neighbours[current];]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const w = around[slot];
      if (@unseen[!vertices[w].seen]) @add{
        vertices[w].seen = true;
        queue.push(w);
      }
    }
  }
</script>

<script listing="textbook">
BFS(start)
@init[queue = [start]]
while @more[the queue is not empty]
  @visit[@take[current = remove the front vertex]
  @first[slot = the first neighbour of current]
  while @another[slot is a neighbour]
    @look[w = neighbour slot
    if @unseen[w is unseen]
      @add[mark w as seen
      add w to the queue]]
    @step[slot = the next neighbour]]
</script>

{#snippet NameText(value: Name)}<Node {value} />{/snippet}
{#snippet SeenWord(value: Seen)}<Node>{value ? 'seen' : 'unseen'}</Node>{/snippet}
{#snippet VertexCard(vertex: Vertex)}
  <Node layout="column">
    {vertex.name}
    {vertex.seen}
  </Node>
{/snippet}
{#snippet VertexNumber(value: VertexRef)}<Node {value} />{/snippet}
{#snippet QueueItems(items: Queue)}
  <Node>{#each items as item}{item}{/each}</Node>
{/snippet}

{#snippet Outline(p: VertexRef)}<Pointed />{/snippet}
{#snippet Captioned(p: VertexRef)}
  {#snippet Caption()}<Node>start here</Node>{/snippet}
  <Node layout="column">
    <Pointed />
    {@render Caption()}
  </Node>
{/snippet}

{#snippet Title()}<Node>Breadth-first search from A</Node>{/snippet}
{#snippet Graph()}
  <Node layout="free">
    {#each vertices as vertex, k}
      {vertex}
      {#each neighbours[k] as w}
        <Link from={k} to={w} />
      {/each}
    {/each}
  </Node>
{/snippet}
{#snippet QueueLine()}
  <Node layout="row">
    <Node>queue</Node>
    {queue}
  </Node>
{/snippet}
{#snippet Board()}
  <Node layout="row">
    <Listing />
    <Node layout="column">
      {@render Graph()}
      {@render QueueLine()}
    </Node>
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Board()}
    {start}
    {current}
  </Node>
</Layout>
