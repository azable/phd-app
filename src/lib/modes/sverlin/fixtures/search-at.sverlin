<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 7 });
  const Index = index(Values);

</script>

<script input>
  const values = Values([3, 8, 15, 23, 42, 57, 71]);
  const target = Int(42);
</script>

<script algorithm>
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = @mid[Index(Math.floor((lo + hi) / 2))];
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>

<View of="Int" name="IntCell"><Node value={this} /></View>

<View of="Index" name="IndexNumber"><Node value={this} /></View>
<View of="Index" name="IndexValue">{at(this)}</View>
<View of="Index" name="Arrow"><Pointed /></View>

<Layout name="Cells" of="values"><Node>{#each values as v}{v}{/each}</Node></Layout>
<Layout name="Bounds" of="lo, hi">
  <Node layout="row">
    <Node>lo</Node>{lo}
    <Node>hi</Node>{hi}
  </Node>
</Layout>

<Layout name="Main" of="lo, hi, values">
  <Node>
    <Cells values={values} />
    <Bounds lo={lo} hi={hi} />
    {lo}
    {hi}
  </Node>
</Layout>

<Storyboard>
  <Scene name="main"><Main lo={lo} hi={hi} values={values} /></Scene>
</Storyboard>
