<script lang="sverlin" domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = collection(Int);
  const Index = index(Values);

</script>

<script lang="sverlin" input>
  const values = Values([3, 8, 15, 23, 42, 57, 71]);
  const target = Int(42);
</script>

<script lang="sverlin">
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = @mid[Index(Math.floor((lo + hi) / 2))];
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}

{#snippet IndexNumber(p: Index)}<Node value={p} />{/snippet}
{#snippet IndexValue(p: Index)}{at(p)}{/snippet}
{#snippet Arrow(p: Index)}<Pointed />{/snippet}

{#snippet Cells()}<Node>{#each values as v}{v}{/each}</Node>{/snippet}
{#snippet Bounds()}
  <Node layout="row">
    <Node>lo</Node>{lo}
    <Node>hi</Node>{hi}
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Cells()}
    {@render Bounds()}
    {lo}
    {hi}
  </Node>
</Layout>
