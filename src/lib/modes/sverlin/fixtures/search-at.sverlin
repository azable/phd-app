<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 7 });
  const Index = index(Values);

</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = @mid[Index(Math.floor((lo + hi) / 2))];
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>

<View of="Int" name="IntCell"><Node value={this} /></View>

<View of="Index" name="Arrow">
  <Node layout="column">
    <Link to={this} />
    <Node kind="Caption">{place()}</Node>
  </Node>
</View>
<View of="Index" name="IndexNumber"><Node value={this} /></View>
<View of="Index" name="IndexValue">{at(this)}</View>

<Layout name="Cells">
  <Node layout="grid">
    {#each values as v, k}<Node row={0} col={k}>{v}</Node>{/each}
    <Node kind="Lane" row={1} col={lo}>{lo}</Node>
    <Node kind="Lane" row={2} col={hi}>{hi}</Node>
  </Node>
</Layout>
<Layout name="Bounds">
  <Node layout="row">
    <Node>lo</Node><Node kind="Bound" value={lo} />
    <Node>hi</Node><Node kind="Bound" value={hi} />
  </Node>
</Layout>

<Layout name="Main">
  <Node>
    <Cells />
    <Bounds />
  </Node>
</Layout>

<Case name="main" values={[3, 8, 15, 23, 42, 57, 71]} target={42} />

<Storyboard>
  <Scene name="main" case="main" pause="@range, @probe.right, @probe.left"><Main /></Scene>
</Storyboard>
