<script domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Seen = type('boolean');
  const Vertex = record({ name: Name, seen: Seen });
  const Vertices = array(Vertex, { max: 5 });
  const VertexRef = index(Vertices);
  const Neighbours = array(VertexRef, { max: 2 });
  const Slot = index(Neighbours);
  const Adjacency = array(Neighbours, { max: 5 });
  const Queue = array(VertexRef, { max: 2 });

</script>

<script input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false }
  ]);
  const neighbours = Adjacency([[1, 2], [3], [3], [4], []]);
  const start = VertexRef(0);
</script>

<script algorithm>
  @init[let queue = Queue([start]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    queue.shift();
    const around = neighbours[current];]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const w = around[slot];
      if (@unseen[!vertices[w].seen]) @add{
        vertices[w].seen = true;
        queue.push(w);
      }
    }
  }
</script>

<View of="Name" name="NameText"><Node value={this} /></View>
<View of="Seen" name="SeenWord"><Node>{this ? 'seen' : 'unseen'}</Node></View>
<View of="Vertex" name="VertexCard">
  <Node layout="column">
    {this.name}
    {this.seen}
  </Node>
</View>

<View of="VertexRef" name="VertexNumber"><Node value={this} /></View>
<View of="VertexRef" name="VertexName">{at(this).name}</View>
<View of="VertexRef" name="VertexMini">{at(this)}</View>

<View of="Queue" name="QueueItems">
  <Node>{#each this as item}{item}{/each}</Node>
</View>

<View of="VertexRef" name="Outline"><Pointed /></View>

<Layout name="Title"><Node>Breadth-first search from A</Node></Layout>
<Layout name="Graph" of="vertices, neighbours">
  <Node layout="free">
    {#each vertices as vertex, k}
      {vertex}
      {#each neighbours[k] as w}
        <Link from={k} to={w} />
      {/each}
    {/each}
  </Node>
</Layout>
<Layout name="QueueLine" of="queue">
  <Node layout="row">
    <Node>queue</Node>
    {queue}
  </Node>
</Layout>
<Layout name="Board" of="vertices, neighbours, queue">
  <Node layout="column">
    <Graph vertices={vertices} neighbours={neighbours} />
    <QueueLine queue={queue} />
  </Node>
</Layout>

<Layout name="Main" of="current, vertices, neighbours, queue">
  <Node>
    <Title />
    <Board vertices={vertices} neighbours={neighbours} queue={queue} />
    {current}
  </Node>
</Layout>

<Storyboard>
  <Scene name="main"><Main current={current} vertices={vertices} neighbours={neighbours} queue={queue} /></Scene>
</Storyboard>
