<script domain>
  const Name = type(['A', 'B', 'C', 'D', 'E']);
  const Seen = type('boolean');
  const Vertex = record({ name: Name, seen: Seen });
  const Vertices = collection(Vertex);
  const VertexRef = index(Vertices);
  const Neighbours = collection(VertexRef);
  const Slot = index(Neighbours);
  const Adjacency = collection(Neighbours);
  const Queue = collection(VertexRef);

</script>

<script input>
  const vertices = Vertices([
    { name: 'A', seen: true },
    { name: 'B', seen: false },
    { name: 'C', seen: false },
    { name: 'D', seen: false },
    { name: 'E', seen: false }
  ]);
  const neighbours = Adjacency([[1, 2], [3], [3], [4], []]);
  const start = VertexRef(0);
</script>

<script algorithm>
  @init[let queue = Queue([start]);]
  while (@more[queue.length > 0]) @visit{
    @take[const current = queue[0];
    queue.shift();
    const around = neighbours[current];]
    for (@first[let slot = Slot(around, 0)]; @another[slot < around.length]; @step[slot++]) @look{
      const w = around[slot];
      if (@unseen[!vertices[w].seen]) @add{
        vertices[w].seen = true;
        queue.push(w);
      }
    }
  }
</script>

{#snippet NameText(this: Name)}<Node value={this} />{/snippet}
{#snippet SeenWord(this: Seen)}<Node>{this ? 'seen' : 'unseen'}</Node>{/snippet}
{#snippet VertexCard(this: Vertex)}
  <Node layout="column">
    {this.name}
    {this.seen}
  </Node>
{/snippet}

{#snippet VertexNumber(this: VertexRef)}<Node value={this} />{/snippet}
{#snippet VertexName(this: VertexRef)}{at(this).name}{/snippet}
{#snippet VertexMini(this: VertexRef)}{at(this)}{/snippet}

{#snippet QueueItems(this: Queue)}
  <Node>{#each this as item}{item}{/each}</Node>
{/snippet}

{#snippet Outline(this: VertexRef)}<Pointed />{/snippet}

{#snippet Title()}<Node>Breadth-first search from A</Node>{/snippet}
{#snippet Graph()}
  <Node layout="free">
    {#each vertices as vertex, k}
      {vertex}
      {#each neighbours[k] as w}
        <Link from={k} to={w} />
      {/each}
    {/each}
  </Node>
{/snippet}
{#snippet QueueLine()}
  <Node layout="row">
    <Node>queue</Node>
    {queue}
  </Node>
{/snippet}
{#snippet Board()}
  <Node layout="column">
    {@render Graph()}
    {@render QueueLine()}
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Board()}
    {current}
  </Node>
</Layout>
