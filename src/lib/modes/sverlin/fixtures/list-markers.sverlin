<script domain>
  const Name = type(['A', 'B', 'C', 'D']);
  const End = type(['end']);
  const ListNode = record({ name: Name, next: Next });
  const NodeRef = ref(ListNode);
  const Next = union(NodeRef, End);

</script>

<script input>
  const head = NodeRef(ListNode({ name: 'A', next:
    NodeRef(ListNode({ name: 'B', next:
      NodeRef(ListNode({ name: 'C', next:
        NodeRef(ListNode({ name: 'D', next: End('end') }))
      }))
    }))
  }));
</script>

<script algorithm>
  @begin[let prev = Next(End('end'));
  let cur = Next(head);]
  while (@more[cur !== 'end']) @rewire{
    @save[const after = cur.next;]
    @reverse[cur.next = prev;]
    @advance[prev = cur;
    cur = after;]
  }
  @finish[const result = prev;]
</script>

<script listing="textbook">
REVERSE(head)
@begin[prev = ∅
cur = head]
while @more[cur ≠ ∅]
    @rewire[@save[next = cur.next]
    @reverse[cur.next = prev]
    @advance[prev = cur
    cur = next]]
@finish[return prev]
</script>

<View of="Name" name="NameCell">
  <Node value={this} />
</View>

<View of="End" name="EndMark">
  <Node>∅</Node>
</View>

<View of="ListNode" name="NodeBox">
  <Node layout="row">
    {this.name}
    <Node kind="NextField"><Link to={this.next} /></Node>
  </Node>
</View>

<View of="NodeRef" name="Marker">
  <Node layout="column">
    <Pointed />
    <Node kind="PointerLabel">{this === prev ? 'prev' : this === cur ? 'cur' : 'next'}</Node>
  </Node>
</View>

<Layout name="Title">
  <Node>Reverse a singly linked list</Node>
</Layout>

<Layout name="Heap">
  <Node layout="free">
    {#each all(ListNode) as node}
      {node}
    {/each}
  </Node>
</Layout>

<Layout name="StartNote">
  <Node>Start with prev at ∅ and cur at the head.</Node>
</Layout>

<Layout name="SaveNote">
  <Node>Save the next node before changing the link.</Node>
</Layout>

<Layout name="ReverseNote">
  <Node>Reverse cur’s link so it points to the finished prefix.</Node>
</Layout>

<Layout name="AdvanceNote">
  <Node>Move prev and cur one node forward.</Node>
</Layout>

<Layout name="FinishNote">
  <Node>prev is now the head of the reversed list.</Node>
</Layout>

<Layout name="StepNote" of="@finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node>
    <OneOf><When of="@rewire.save">
      <SaveNote />
    </When><When of="@rewire.reverse">
      <ReverseNote />
    </When><When of="@rewire.advance">
      <AdvanceNote />
    </When><When of="@finish">
      <FinishNote />
    </When></OneOf>
    <When of="start">
      <StartNote />
    </When>
  </Node>
</Layout>

<Layout name="Diagram" of="@finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node layout="column">
    <Heap />
    <StepNote />
  </Node>
</Layout>

<Layout name="Board" of="@finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node layout="row">
    <Listing />
    <Diagram />
  </Node>
</Layout>

<Layout name="Main" of="prev, cur, after, @finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node>
    <Title />
    <Board />
    {prev}
    {cur}
    {after}
  </Node>
</Layout>
