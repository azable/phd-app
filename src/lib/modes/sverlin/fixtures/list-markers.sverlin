<script lang="sverlin" domain>
  const Name = type(['A', 'B', 'C', 'D']);
  const Flag = type('boolean');
  const End = type(['end']);
  const ListNode = record({ name: Name, next: Next });
  const NodeRef = ref(ListNode);
  const Next = union(NodeRef, End);

  const IsNode = unop((p: Next) => Flag(p !== 'end'));
</script>

<script lang="sverlin" input>
  const head = NodeRef(ListNode({ name: 'A', next:
    NodeRef(ListNode({ name: 'B', next:
      NodeRef(ListNode({ name: 'C', next:
        NodeRef(ListNode({ name: 'D', next: End('end') }))
      }))
    }))
  }));
</script>

<script lang="sverlin">
  @begin[let prev = Next(End('end'));
  let cur = Next(head);]
  while (@more[IsNode(cur)]) @rewire{
    @save[const after = cur.next;]
    @reverse[cur.next = prev;]
    @advance[prev = cur;
    cur = after;]
  }
  @finish[const result = prev;]
</script>

<script lang="sverlin" listing="textbook">
REVERSE(head)
@begin[prev = ∅
cur = head]
while @more[cur ≠ ∅]
    @rewire[@save[next = cur.next]
    @reverse[cur.next = prev]
    @advance[prev = cur
    cur = next]]
@finish[return prev]
</script>

{#snippet NameCell(value: Name)}
  <Node {value} />
{/snippet}

{#snippet EndMark(value: End)}
  <Node>∅</Node>
{/snippet}

{#snippet NodeBox(node: ListNode)}
  {#snippet NextField()}
    <Node><Link to={node.next} /></Node>
  {/snippet}
  <Node layout="row">
    {node.name}
    {@render NextField()}
  </Node>
{/snippet}

{#snippet Marker(pointer: NodeRef)}
  {#snippet PointerLabel()}
    <Node>{pointer === prev ? 'prev' : pointer === cur ? 'cur' : 'next'}</Node>
  {/snippet}
  <Node layout="column">
    <Pointed />
    {@render PointerLabel()}
  </Node>
{/snippet}

{#snippet Title()}
  <Node>Reverse a singly linked list</Node>
{/snippet}

{#snippet Heap()}
  <Node layout="free">
    {#each all(ListNode) as node}
      {node}
    {/each}
  </Node>
{/snippet}

{#snippet StartNote()}
  <Node>Start with prev at ∅ and cur at the head.</Node>
{/snippet}

{#snippet SaveNote()}
  <Node>Save the next node before changing the link.</Node>
{/snippet}

{#snippet ReverseNote()}
  <Node>Reverse cur’s link so it points to the finished prefix.</Node>
{/snippet}

{#snippet AdvanceNote()}
  <Node>Move prev and cur one node forward.</Node>
{/snippet}

{#snippet FinishNote()}
  <Node>prev is now the head of the reversed list.</Node>
{/snippet}

{#snippet StepNote()}
  <Node>
    <OneOf><When of="@rewire.save">
      {@render SaveNote()}
    </When><When of="@rewire.reverse">
      {@render ReverseNote()}
    </When><When of="@rewire.advance">
      {@render AdvanceNote()}
    </When><When of="@finish">
      {@render FinishNote()}
    </When></OneOf>
    <When of="start">
      {@render StartNote()}
    </When>
  </Node>
{/snippet}

{#snippet Diagram()}
  <Node layout="column">
    {@render Heap()}
    {@render StepNote()}
  </Node>
{/snippet}

{#snippet Board()}
  <Node layout="row">
    <Listing />
    {@render Diagram()}
  </Node>
{/snippet}

<Layout name="Main">
  <Node>
    {@render Title()}
    {@render Board()}
    {prev}
    {cur}
    {after}
  </Node>
</Layout>
