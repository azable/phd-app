<script domain>
  const Name = type(['A', 'B', 'C', 'D']);
  const End = type(['end']);
  const ListNode = record({ name: Name, next: Next });
  const ListNodes = pool(ListNode, { max: 4 });
  const NodeRef = ref(ListNode);
  const Next = union(NodeRef, End);

</script>

<script input>
  const nodes = ListNodes;
  const head = NodeRef;
</script>

<script algorithm>
  @begin[let prev = Next(End('end'));
  let cur = Next(head);]
  while (@more[cur !== 'end']) @rewire{
    @save[const next = cur.next;]
    @reverse[cur.next = prev;]
    @advance[prev = cur;
    cur = next;]
  }
  @finish[const result = prev;]
</script>

<script listing="textbook">
REVERSE(head)
@begin[prev = ∅
cur = head]
while @more[cur ≠ ∅]
    @rewire[@save[next = cur.next]
    @reverse[cur.next = prev]
    @advance[prev = cur
    cur = next]]
@finish[return prev]
</script>

<View of="Name" name="NameCell">
  <Node value={this} />
</View>

<View of="End" name="EndMark">
  <Node>∅</Node>
</View>

<View of="ListNode" name="NodeBox">
  <Node layout="row">
    {this.name}
    <Node kind="NextField"><Link to={this.next} /></Node>
  </Node>
</View>

<View of="NodeRef" name="RefArrow">
  <Node layout="column">
    <Node kind="Caption">{place()}</Node>
    <Link to={this} />
  </Node>
</View>

<Layout name="Title">
  <Node>Reverse a singly linked list</Node>
</Layout>

<Layout name="Nodes" of="nodes, prev, cur, next">
  <Node layout="free">
    {#each nodes as node}
      {node}
    {/each}
    <Node kind="Var">{prev}</Node>
    <Node kind="Var">{cur}</Node>
    <Node kind="Var">{next}</Node>
  </Node>
</Layout>

<Layout name="StartNote">
  <Node>Start with prev at ∅ and cur at the head.</Node>
</Layout>

<Layout name="SaveNote">
  <Node>Save the next node before changing the link.</Node>
</Layout>

<Layout name="ReverseNote">
  <Node>Reverse cur’s link so it points to the finished prefix.</Node>
</Layout>

<Layout name="AdvanceNote">
  <Node>Move prev and cur one node forward.</Node>
</Layout>

<Layout name="FinishNote">
  <Node>prev is now the head of the reversed list.</Node>
</Layout>

<Layout name="StepNote" of="@finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node>
    <Node layout="stack"><Node when="@rewire.save">
      <SaveNote />
    </Node><Node when="@rewire.reverse">
      <ReverseNote />
    </Node><Node when="@rewire.advance">
      <AdvanceNote />
    </Node><Node when="@finish">
      <FinishNote />
    </Node></Node>
    <Node when=":before">
      <StartNote />
    </Node>
  </Node>
</Layout>

<Layout name="Diagram" of="nodes, prev, cur, next, @finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node layout="column">
    <Nodes nodes={nodes} prev={prev} cur={cur} next={next} />
    <StepNote />
  </Node>
</Layout>

<Layout name="Board" of="nodes, prev, cur, next, @finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node layout="row">
    <Listing />
    <Diagram nodes={nodes} prev={prev} cur={cur} next={next} />
  </Node>
</Layout>

<Layout name="Main" of="nodes, prev, cur, next, @finish, @rewire.save, @rewire.reverse, @rewire.advance">
  <Node>
    <Title />
    <Board nodes={nodes} prev={prev} cur={cur} next={next} />
  </Node>
</Layout>

<Case name="main" head={nodes.add(ListNode({ name: 'A', next:
    nodes.add(ListNode({ name: 'B', next:
      nodes.add(ListNode({ name: 'C', next:
        nodes.add(ListNode({ name: 'D', next: End('end') }))
      }))
    }))
  }))} />

<Storyboard>
  <Scene name="main" case="main" pause="@begin, @rewire, @rewire.save, @rewire.reverse, @rewire.advance, @finish"><Main nodes={nodes} prev={prev} cur={cur} next={next} /></Scene>
</Storyboard>
