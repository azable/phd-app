<script lang="sverlin" domain>
  const Int = type('integer', { min: 0, max: 9 });
  const Values = collection(Int);
  const Position = index(Values);
  const Flag = type('boolean');

  const Length = unop((v: Values) => Position(v.length));
  const Before = binop((a: Position, b: Position) => Flag(a < b));
  const Next = unop((p: Position) => Position(p + 1));
  const Prev = unop((p: Position) => Position(p - 1));

  const Greater = binop((a: Int, b: Int) => Flag(a > b));
</script>

<script lang="sverlin" input>
  const values = Values([5, 1, 4, 2, 3]);
</script>

<script lang="sverlin">
  for (let end = Length(values); Before(Position(1), end); end = Prev(end)) @pass{
    for (let i = Position(1); Before(i, end); i = Next(i)) @pair{
      if (@compare[Greater(values[@left[Prev(i)]], values[@right[i]])]) @swap{
        const moved = values[@from[Prev(i)]];
        values[Prev(i)] = values[@to[i]];
        values[i] = moved;
      }
    }
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}
{#snippet CompareMark(p: Position)}<Pointed />{/snippet}
{#snippet SwapMark(p: Position)}<Pointed />{/snippet}
{#snippet Ask(g: Greater)}
  <Node>compare {@render Int(g.a)} and {@render Int(g.b)}</Node>
{/snippet}
{#snippet SwapNote()}<Node>Swap</Node>{/snippet}
{#snippet Title()}<Node>Bubble sort</Node>{/snippet}
{#snippet Cells(list: Values)}
  <Node>{#each list as v}{@render Int(v)}{/each}</Node>
{/snippet}
{#snippet Board()}
  <Node layout="column">
    {@render Values(values)}
    {#if when(@pass.pair.swap)}
      <Link from={@pass.pair.swap.from} to={@pass.pair.swap.to} />
    {/if}
    {@render Greater(@pass.pair.compare)}
    {#if when(@pass.pair.swap)}{@render SwapNote()}{/if}
  </Node>
{/snippet}

{@render Title()}
{@render Board()}
{@render Position(@pass.pair.compare.left)}
{@render Position(@pass.pair.compare.right)}
{#if when(@pass.pair.swap)}
  {@render Position(@pass.pair.swap.from)}
  {@render Position(@pass.pair.swap.to)}
{/if}
