<script lang="sverlin" domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = collection(Int);
  const Index = index(Values);
  const Flag = type('boolean');

  const Middle = binop((a: Index, b: Index) => Index(Math.floor((a + b) / 2)));
  const Before = binop((a: Index, b: Index) => Flag(a <= b));
  const Less = binop((a: Int, b: Int) => Flag(a < b));
  const Next = unop((p: Index) => Index(p + 1));
  const Prev = unop((p: Index) => Index(p - 1));
  const Last = unop((v: Values) => Index(v.length - 1));
</script>

<script lang="sverlin" input>
  const values = Values([3, 8, 15, 23, 42, 57, 71]);
  const target = Int(42);
</script>

<script lang="sverlin">
  @range[let lo = Index(0);
  let hi = Last(values);]
  while (@open[Before(lo, hi)]) @probe{
    const mid = Middle(lo, hi);
    if (@low[Less(values[mid], target)]) @right[lo = Next(mid);]
    else @left[hi = Prev(mid);]
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}
{#snippet IndexNumber(p: Index)}<Node value={p} />{/snippet}

{#snippet LowerMark(p: Index)}
  {#snippet LowerLabel()}<Node>lo</Node>{/snippet}
  <Node layout="column"><Pointed />{@render LowerLabel()}</Node>
{/snippet}

{#snippet UpperMark(p: Index)}
  {#snippet UpperLabel()}<Node>hi</Node>{/snippet}
  <Node layout="column"><Pointed />{@render UpperLabel()}</Node>
{/snippet}

{#snippet Cells()}<Node>{#each values as v}{@render Int(v)}{/each}</Node>{/snippet}

<Layout name="Main">
  <Node>
    <Node layout="row"><Node>Searching for {@render Int(target)}</Node>{@render Cells()}</Node>
    {@render Index(lo)}
    {@render Index(hi)}
  </Node>
</Layout>
