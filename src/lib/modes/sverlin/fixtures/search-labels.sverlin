<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = array(Int, { max: 7 });
  const Index = index(Values);

</script>

<script input>
  const values = Values;
  const target = Int;
</script>

<script algorithm>
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = Index(Math.floor((lo + hi) / 2));
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>

<View of="Int" name="IntCell"><Node value={this} /></View>
<View of="Index" name="IndexNumber"><Node value={this} /></View>

<View of="Index" name="LowerMark">
  <Node layout="column"><Pointed /><Node kind="LowerLabel">lo</Node></Node>
</View>

<View of="Index" name="UpperMark">
  <Node layout="column"><Pointed /><Node kind="UpperLabel">hi</Node></Node>
</View>

<Layout name="Cells" of="values"><Node>{#each values as v}{v}{/each}</Node></Layout>

<Layout name="Main" of="target, lo, hi, values">
  <Node>
    <Node layout="row"><Node>Searching for {target}</Node><Cells values={values} /></Node>
    {lo}
    {hi}
  </Node>
</Layout>

<Case name="main" values={[3, 8, 15, 23, 42, 57, 71]} target={42} />

<Storyboard>
  <Scene name="main" case="main" pause="@range, @probe.right, @probe.left"><Main target={target} lo={lo} hi={hi} values={values} /></Scene>
</Storyboard>
