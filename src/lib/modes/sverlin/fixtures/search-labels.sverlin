<script domain>
  const Int = type('integer', { min: 0, max: 99 });
  const Values = collection(Int);
  const Index = index(Values);

</script>

<script input>
  const values = Values([3, 8, 15, 23, 42, 57, 71]);
  const target = Int(42);
</script>

<script algorithm>
  @range[let lo = Index(0);
  let hi = values.length - 1;]
  while (@open[lo <= hi]) @probe{
    const mid = Index(Math.floor((lo + hi) / 2));
    if (@low[values[mid] < target]) @right[lo = mid + 1;]
    else @left[hi = mid - 1;]
  }
</script>

{#snippet IntCell(value: Int)}<Node {value} />{/snippet}
{#snippet IndexNumber(p: Index)}<Node value={p} />{/snippet}

{#snippet LowerMark(p: Index)}
  {#snippet LowerLabel()}<Node>lo</Node>{/snippet}
  <Node layout="column"><Pointed />{@render LowerLabel()}</Node>
{/snippet}

{#snippet UpperMark(p: Index)}
  {#snippet UpperLabel()}<Node>hi</Node>{/snippet}
  <Node layout="column"><Pointed />{@render UpperLabel()}</Node>
{/snippet}

{#snippet Cells()}<Node>{#each values as v}{v}{/each}</Node>{/snippet}

<Layout name="Main">
  <Node>
    <Node layout="row"><Node>Searching for {target}</Node>{@render Cells()}</Node>
    {lo}
    {hi}
  </Node>
</Layout>
