<script domain>
  const Int = type('integer', { min: 0, max: 20 });
</script>

<script input>
  const n = Int;
</script>

<script algorithm>
  function fib(k) @fib{
    if (@base[k < 2]) @small[return k;]
    @sum[return fib(k - 1) + fib(k - 2);]
  }

  @run[const answer = fib(n);]
</script>

<View of="Int" name="Cell"><Node value={this} /></View>
<View of="@fib" name="Frame">
  <Node>fib({this.k}) = {this.result}</Node>
</View>

<Select name="calls" from="@fib" where="started <= now" order="started" max="15" />

<Layout name="Calls">
  <Node layout="column">{#each calls as call}{call}{/each}</Node>
</Layout>

<Case name="five" n={5} />

<Storyboard>
  <Scene name="calls" case="five" pause="@fib:before, @fib">
    <Calls />
  </Scene>
</Storyboard>
