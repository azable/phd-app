{
  "source": "<script lang=\"sverlin\" domain>\n  const Int = type('integer', { min: 0, max: 9 });\n  const Flag = type('boolean');\n  const NotFound = type(['not found']);\n  const Values = collection(Int);\n  const Index = index(Values);\n  const Result = union(Index, NotFound);\n\n  const Length = unop((list: Values) => Index(list.length));\n  const Before = binop((a: Index, b: Index) => Flag(a < b));\n  const Next = unop((p: Index) => Index(p + 1));\n  const Equal = binop((a: Int, b: Int) => Flag(a === b));\n</script>\n\n<script lang=\"sverlin\" input>\n  const values = Values([4, 7, 2, 9, 5]);\n  const target = Int(9);\n</script>\n\n<script lang=\"sverlin\">\n  function linearSearch(list, sought) {\n    for (let i = Index(list, 0); Before(i, Length(list)); i = Next(i)) {\n      if (@check[Equal(list[i], sought)]) @found{\n        return i;\n      }\n    }\n    @missing[return NotFound('not found');]\n  }\n\n  const answer = linearSearch(values, target);\n</script>\n\n<script lang=\"sverlin\" listing=\"textbook\">\nLINEAR-SEARCH(A, target)\nfor i = 0 to length(A) - 1\n    @check[if A[i] = target]\n        @found[return i]\n@missing[return not found]\n</script>\n\n{#snippet IntCell(value: Int)}\n  <Node value={value} />\n{/snippet}\n\n{#snippet IntTally(value: Int)}\n  {#snippet Tally()}<Node>{'•'.repeat(value)}</Node>{/snippet}\n  <Node layout=\"column\"><Node value={value} />{@render Tally()}</Node>\n{/snippet}\n\n{#snippet FlagWord(value: Flag)}\n  <Node>{value ? 'yes' : 'no'}</Node>\n{/snippet}\n\n{#snippet CheckMark(p: Index)}\n  {#snippet PointerCaption()}<Node>checking</Node>{/snippet}\n  <Node layout=\"column\"><Pointed />{@render PointerCaption()}</Node>\n{/snippet}\n\n{#snippet ResultCard(value: Result)}\n  <Node>\n    {#if value === 'not found'}\n      The target is not in the list\n    {:else}\n      Found at index {value}\n    {/if}\n  </Node>\n{/snippet}\n\n{#snippet EqualityQuestion(e: Equal)}\n  <Node>Does {@render Int(e.a)} match {@render Int(e.b)}? {@render Flag(e.value)}</Node>\n{/snippet}\n\n{#snippet Title()}\n  <Node>Linear search for {@render Int(target)}</Node>\n{/snippet}\n\n{#snippet Cells()}\n  <Node>{#each values as value}{@render Int(value)}{/each}</Node>\n{/snippet}\n\n{#snippet FoundCaption()}\n  <Node>Match found — return this index.</Node>\n{/snippet}\n\n{#snippet MissingCaption()}\n  <Node>Every value was checked, so the target is not present.</Node>\n{/snippet}\n\n{#snippet Answer()}\n  <When of=\"end\">\n    <Node layout=\"column\"><Node>Result</Node>{@render Result(answer)}</Node>\n  </When>\n{/snippet}\n\n{#snippet SearchView()}\n  <Node layout=\"column\">\n    {@render Title()}\n    {@render Cells()}\n    <OneOf><When of=\"@check\">\n      {@render Equal(@check)}\n    </When><When of=\"@found\">\n      {@render FoundCaption()}\n    </When><When of=\"@missing\">\n      {@render MissingCaption()}\n    </When></OneOf>\n    {@render Answer()}\n  </Node>\n{/snippet}\n\n{#snippet Board()}\n  <Node layout=\"row\"><Listing />{@render SearchView()}</Node>\n{/snippet}\n\n<Layout name=\"Main\">\n  <Node>\n    {@render Board()}\n    {@render Index(i)}\n  </Node>\n</Layout>\n",
