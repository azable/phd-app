{
  "source": "<script domain>\n  const Int = type('integer', { min: 0, max: 9 });\n  const Flag = type('boolean');\n  const NotFound = type(['not found']);\n  const Values = array(Int);\n  const Index = index(Values);\n  const Result = union(Index, NotFound);\n\n  const Length = unop((list: Values) => Index(list.length));\n  const Before = binop((a: Index, b: Index) => Flag(a < b));\n  const Next = unop((p: Index) => Index(p + 1));\n  const Equal = binop((a: Int, b: Int) => Flag(a === b));\n</script>\n\n<script input>\n  const values = Values([4, 7, 2, 9, 5]);\n  const target = Int(9);\n</script>\n\n<script algorithm>\n  function linearSearch(list, sought) {\n    for (let i = Index(list, 0); Before(i, Length(list)); i = Next(i)) {\n      if (@check[Equal(list[i], sought)]) @found{\n        return i;\n      }\n    }\n    @missing[return NotFound('not found');]\n  }\n\n  const answer = linearSearch(values, target);\n</script>\n\n<script listing=\"textbook\">\nLINEAR-SEARCH(A, target)\nfor i = 0 to length(A) - 1\n    @check[if A[i] = target]\n        @found[return i]\n@missing[return not found]\n</script>\n\n<View of=\"Int\" name=\"IntCell\">\n  <Node value={this} />\n</View>\n\n<View of=\"Int\" name=\"IntTally\">\n  <Node layout=\"column\"><Node value={this} /><Node kind=\"Tally\">{'•'.repeat(this)}</Node></Node>\n</View>\n\n<View of=\"Flag\" name=\"FlagWord\">\n  <Node>{this ? 'yes' : 'no'}</Node>\n</View>\n\n<View of=\"Index\" name=\"CheckMark\">\n  <Node layout=\"column\"><Link to={this} /><Node kind=\"PointerCaption\">checking</Node></Node>\n</View>\n\n<View of=\"Result\" name=\"ResultCard\">\n  <Node>\n    {#if this === 'not found'}\n      The target is not in the list\n    {:else}\n      Found at index {this}\n    {/if}\n  </Node>\n</View>\n\n<View of=\"Equal\" name=\"EqualityQuestion\">\n  <Node>Does {this.a} match {this.b}? {this.value}</Node>\n</View>\n\n<Layout name=\"Title\">\n  <Node>Linear search for {target}</Node>\n</Layout>\n\n<Layout name=\"Cells\">\n  <Node>{#each values as value}{value}{/each}</Node>\n</Layout>\n\n<Layout name=\"FoundCaption\">\n  <Node>Match found — return this index.</Node>\n</Layout>\n\n<Layout name=\"MissingCaption\">\n  <Node>Every value was checked, so the target is not present.</Node>\n</Layout>\n\n<Layout name=\"Answer\">\n  <When of=\":after\">\n    <Node layout=\"column\"><Node>Result</Node>{answer}</Node>\n  </When>\n</Layout>\n\n<Layout name=\"SearchView\">\n  <Node layout=\"column\">\n    <Title />\n    <Cells />\n    <OneOf><When of=\"@check\">\n      {@check}\n    </When><When of=\"@found\">\n      <FoundCaption />\n    </When><When of=\"@missing\">\n      <MissingCaption />\n    </When></OneOf>\n    <Answer />\n  </Node>\n</Layout>\n\n<Layout name=\"Board\">\n  <Node layout=\"row\"><Listing /><SearchView /></Node>\n</Layout>\n\n<Layout name=\"Main\">\n  <Node>\n    <Board />\n    {i}\n  </Node>\n</Layout>\n",
